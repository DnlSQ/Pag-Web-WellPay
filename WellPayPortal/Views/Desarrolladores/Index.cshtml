                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 28px;">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                        <i class="bi bi-arrow-repeat fs-4"></i>
                    </div>
