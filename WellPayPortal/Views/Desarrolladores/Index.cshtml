<!-- ============================================================
     API
     ============================================================ -->
<section id="api" class="py-5 position-relative overflow-hidden bg-light-subtle">
    <div class="glow-shape glow-services-top-right"></div>
    <div class="glow-shape glow-services-bottom-left"></div>

    <div class="container py-3 position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;">API</small>
                </div>

                <h2 class="display-6 fw-extrabold text-dark mb-4 lh-sm">
                    Una API <span class="text-wellpay">simple y predecible</span>
                </h2>

                <p class="text-secondary fs-6 fw-normal mb-3">
                    Nuestra API REST está pensada para que puedas crear un cobro, consultar su estado
                    o recibir notificaciones vía webhook con solo unas líneas de código.
                </p>

                <!-- TODO: reemplazar por la especificación real de la API cuando esté definida -->
                <p class="text-muted small fst-italic mb-0">
                    El ejemplo a la derecha es solo ilustrativo, para mostrar el estilo de integración
                    que buscamos ofrecer.
                </p>
            </div>

            <div class="col-lg-6">
                <div class="code-card">
                    <div class="code-card-header">
                        <span class="code-dot" style="background:#ff5f57;"></span>
                        <span class="code-dot" style="background:#febc2e;"></span>
                        <span class="code-dot" style="background:#28c840;"></span>
                        <span class="code-card-title">wellpay-integration.ts</span>
                    </div>
                    <pre class="code-card-body"><code>POST /v1/payment_intents
Authorization: Bearer sk_test_...
Content-Type: application/json

{
  "amount": 45500,
  "currency": "CRC",
  "method": "sinpe_movil"
}

// Respuesta
{
  "id": "pi_wellpay_9x7rA2k19cJ",
  "status": "approved",
  "amount": 45500,
  "currency": "CRC"
}</code></pre>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     SANDBOX / AMBIENTE DE PRUEBAS
     ============================================================ -->
<section id="sandbox" class="py-5 bg-white position-relative overflow-hidden">
    <div class="container py-3 position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 order-lg-2">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;">Sandbox</small>
                </div>

                <h2 class="display-6 fw-extrabold text-dark mb-4 lh-sm">
                    Probá tu integración <span class="text-wellpay">sin riesgo</span>
                </h2>

                <!-- TODO: confirmar el flujo real de acceso al sandbox (registro, credenciales, tarjetas de prueba) -->
                <p class="text-secondary fs-6 fw-normal mb-0">
                    El ambiente de pruebas (sandbox) te permite simular transacciones completas, sin
                    mover dinero real, para validar tu integración antes de salir a producción.
                </p>
            </div>

            <div class="col-lg-6 order-lg-1">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 32px;">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                        <i class="bi bi-terminal-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">¿Qué incluye el sandbox?</h5>
                    <ul class="text-muted mb-0 ps-3">
                        <li>Credenciales de prueba independientes de producción</li>
                        <li>Tarjetas y cuentas simuladas para cada método de pago</li>
                        <li>Webhooks de prueba para validar tus notificaciones</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

