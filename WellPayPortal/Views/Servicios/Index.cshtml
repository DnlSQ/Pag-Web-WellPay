            </div>

            <div id="verificador-sinpe" class="col-md-6">
                <div class="service-card-v2 h-100">
                    <div class="d-flex align-items-start gap-3">
                        <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3 flex-shrink-0">
                            <i class="bi bi-patch-check-fill fs-4"></i>
                        </div>
