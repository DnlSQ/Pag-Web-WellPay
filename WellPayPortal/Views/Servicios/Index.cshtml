@{
    ViewData["Title"] = "Servicios";
}

<!-- MINI HERO SERVICIOS -->
<section id="servicios" class="py-5 bg-white position-relative overflow-hidden">
    <div class="glow-shape glow-top-right"></div>
    <div class="glow-shape glow-bottom-right"></div>

    <div class="container py-4 position-relative text-center" style="z-index: 2;">
        <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
            <i class="bi bi-grid-1x2-fill"></i>
            <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;">Servicios</small>
        </div>

        <h1 class="display-5 fw-extrabold text-dark mb-3 lh-sm">
            Todos los servicios financieros <span class="text-wellpay">desde una sola plataforma</span>
        </h1>

        <p class="lead text-secondary fs-6 fw-normal mx-auto" style="max-width: 700px;">
            Cuentas, transferencias, cobros masivos, pagos con tarjeta y datáfonos físicos,
            integrados en una sola cuenta Well-Pay.
        </p>
    </div>
</section>

<!-- ============================================================
     CUENTAS Y TRANSFERENCIAS
     ============================================================ -->
<section class="py-5 position-relative overflow-hidden bg-light-subtle">

    <div class="container py-3 position-relative" style="z-index: 2;">
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;">Cuentas y transferencias</small>
                </div>

                <h2 class="display-6 fw-extrabold text-dark mb-4 lh-sm">
                    Movimiento de fondos <span class="text-wellpay">en tiempo real</span>
                </h2>
            </div>
        </div>

        <div class="row g-4 row-cols-1 row-cols-sm-2 row-cols-lg-3">
            <div id="creacion-cuentas-iban" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 28px;">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                        <i class="bi bi-bank fs-4"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Creación de cuentas IBAN</h6>
                    <!-- TODO: confirmar detalles operativos exactos con el equipo -->
                    <p class="text-muted mb-0 small">
                        Abrí una cuenta IBAN para tu empresa y centralizá tus fondos con un número
                        de cuenta listo para recibir transferencias locales e internacionales.
                    </p>
                </div>
            </div>

            <div id="pago-inmediato-pin" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 28px;">
                    <div class="service-icon-shape bg-light-blue text-primary-custom rounded-circle mb-3">
                        <i class="bi bi-lightning-charge-fill fs-4"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Pago Inmediato (PIN)</h6>
                    <p class="text-muted mb-0 small">
                        Recibí transferencias interbancarias que se acreditan al instante,
                        disponibles de inmediato para tu operación diaria.
                    </p>
                </div>
            </div>

            <div id="debito-tiempo-real-dtr" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 28px;">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                        <i class="bi bi-arrow-left-right fs-4"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Débito en Tiempo Real (DTR)</h6>
                    <p class="text-muted mb-0 small">
                        Debitá la cuenta de tu cliente en tiempo real con su autorización previa,
                        ideal para cobros recurrentes o consumos inmediatos.
                    </p>
                </div>
            </div>

            <div id="sinpe-movil" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 28px;">
                    <div class="service-icon-shape bg-light-blue text-primary-custom rounded-circle mb-3">
                        <i class="bi bi-phone-fill fs-4"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">SINPE Móvil</h6>
                    <p class="text-muted mb-0 small">
                        Aceptá y realizá pagos usando solo el número de teléfono de tu cliente,
                        a través del sistema SINPE Móvil del Banco Central de Costa Rica.
                    </p>
                </div>
            </div>

            <div id="verificador-sinpe" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 28px;">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                        <i class="bi bi-patch-check-fill fs-4"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Verificador SINPE</h6>
                    <p class="text-muted mb-0 small">
                        Confirmá al instante si un comprobante de SINPE Móvil es válido antes de
                        entregar tu producto o servicio, evitando fraudes con capturas falsas.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     PAGOS Y COBROS MASIVOS
     ============================================================ -->
<section class="py-5 bg-white position-relative overflow-hidden">
    <div class="glow-shape glow-services-top-right"></div>
    <div class="glow-shape glow-services-bottom-left"></div>

    <div class="container py-3 position-relative" style="z-index: 2;">
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;">Pagos y cobros masivos</small>
                </div>

                <h2 class="display-6 fw-extrabold text-dark mb-4 lh-sm">
                    Operá a <span class="text-wellpay">escala, sin fricción</span>
                </h2>
            </div>
        </div>

        <div class="row g-4 row-cols-1 row-cols-md-2 justify-content-center">
            <div id="pagos-masivos" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 32px;">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                        <i class="bi bi-send-check-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Pagos Masivos</h5>
                    <p class="text-muted mb-0">
                        Programá el pago a múltiples proveedores, empleados o beneficiarios en
                        un solo lote, sin hacer transferencias una por una.
                    </p>
                </div>
            </div>

            <div id="cobros-masivos" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 32px;">
                    <div class="service-icon-shape bg-light-blue text-primary-custom rounded-circle mb-3">
                        <i class="bi bi-collection-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Cobros Masivos</h5>
                    <p class="text-muted mb-0">
                        Generá cobros recurrentes a muchos clientes a la vez (cuotas, membresías,
                        suscripciones) y llevá el control de quién ya pagó.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     PAGOS CON TARJETA
     ============================================================ -->
<section id="pagos-con-tarjeta" class="py-5 position-relative overflow-hidden bg-light-subtle">

    <div class="container py-3 position-relative" style="z-index: 2;">
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;">Pagos con tarjeta</small>
                </div>

                <h2 class="display-6 fw-extrabold text-dark mb-4 lh-sm">
                    Tres formas de <span class="text-wellpay">cobrar con tarjeta</span>
                </h2>

                <p class="lead text-secondary fs-6 fw-normal">
                    Elegí la que mejor se adapte a tu negocio, o combiná varias.
                </p>
            </div>
        </div>

        <div class="row g-4 row-cols-1 row-cols-md-3">
            <div id="checkout" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle text-center" style="border-radius: 32px;">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3 mx-auto">
                        <i class="bi bi-window fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Checkout</h5>
                    <p class="text-muted mb-0 small">
                        Un formulario de pago seguro para incrustar en tu sitio web y cobrar con
                        tarjeta sin que tu cliente salga de tu página.
                    </p>
                </div>
            </div>

            <div id="link-de-pagos" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle text-center" style="border-radius: 32px;">
                    <div class="service-icon-shape bg-light-blue text-primary-custom rounded-circle mb-3 mx-auto">
                        <i class="bi bi-link-45deg fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Link de pagos</h5>
                    <p class="text-muted mb-0 small">
                        Generá un link de cobro y compartilo por WhatsApp, correo o redes sociales,
                        sin necesidad de tener una tienda en línea.
                    </p>
                </div>
            </div>

            <div id="cargos-recurrentes" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle text-center" style="border-radius: 32px;">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3 mx-auto">
                        <i class="bi bi-arrow-repeat fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Cargos recurrentes</h5>
                    <p class="text-muted mb-0 small">
                        Configurá cobros automáticos periódicos a la tarjeta de tu cliente, ideal
                        para suscripciones o membresías.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     DATÁFONOS FÍSICOS
     ============================================================ -->
<section id="datafonos-fisicos" class="py-5 bg-white position-relative overflow-hidden">
    <div class="glow-shape glow-services-top-left"></div>
    <div class="glow-shape glow-services-bottom-right"></div>

    <div class="container py-3 position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <div class="col-lg-3 d-none d-lg-block">
                <img src="~/images/logos/Datafono.png" alt="Datáfono Well-Pay" class="img-fluid" />
            </div>

            <div class="col-lg-5">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;">Datáfonos físicos</small>
                </div>

                <h2 class="display-6 fw-extrabold text-dark mb-4 lh-sm">
                    Cobrá en persona <span class="text-wellpay">con un solo dispositivo</span>
                </h2>

                <!-- TODO: confirmar modelo(s) definitivo(s) y condiciones comerciales (compra/alquiler) del datáfono -->
                <p class="text-secondary fs-6 fw-normal mb-3">
                    Nuestros datáfonos aceptan pagos por chip, contactless (NFC), banda magnética y
                    código QR, con pantalla táctil grande para una experiencia clara tanto para vos
                    como para tu cliente.
                </p>

                <p class="text-muted small fst-italic mb-0">
                    Modelo de referencia: SUNMI P3 — pantalla de 6.75", sistema operativo basado
                    en Android, certificación PCI PTS y aprobación Visa/Mastercard/American Express.
                </p>
            </div>

            <div class="col-lg-4">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 32px;">
                    <h5 class="fw-bold text-dark mb-3">Acepta todos los métodos</h5>
                    <img src="~/images/logos/DatafonoMetodos.png" alt="Datáfono aceptando pago por QR, contactless, chip y PIN" class="img-fluid w-100" />
                </div>
            </div>
        </div>
    </div>
</section>
