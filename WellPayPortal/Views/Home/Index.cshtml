                                        <span class="badge bg-danger-subtle text-danger p-1 rounded-circle"><i class="bi bi-arrow-down-left"></i></span>
                                        <div>
                                            <div class="fw-bold text-dark" data-es="Transferencia - Proveedor B" data-en="Transfer - Supplier B">Transferencia - Proveedor B</div>
                                            <small class="text-muted" style="font-size: 0.6rem;" data-es="Hoy, 9:30 a. m." data-en="Today, 9:30 a.m.">Hoy, 9:30 a. m.</small>
                                        </div>
                                    </div>
                                    <span class="fw-bold text-danger">- ₡75.000,00</span>
                                </div>

                                <div class="d-flex align-items-center justify-content-between p-1">
