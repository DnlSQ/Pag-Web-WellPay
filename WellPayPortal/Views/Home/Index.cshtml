<!-- =========================================
     SECCIÓN: NUESTROS SERVICIOS (CON GLOW DE FONDO)
     ========================================= -->

<section class="py-5 bg-white position-relative overflow-hidden">

    <!-- Luces de fondo (Glow) en las 4 esquinas -->

    <div class="container pt-3 pb-5 position-relative" style="z-index: 2;">

        <!-- Fila Superior: Títulos Centrados -->
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <!-- Badge Verde -->
                <!-- Título Grande -->
                <h2 class="display-5 fw-extrabold text-dark mb-4 lh-sm">
                    Una plataforma para <span class="text-primary-custom">mover, cobrar y administrar dinero</span>
                </h2>

                <!-- Subtítulo -->
                <p class="lead text-secondary fs-6 fw-normal max-w-700 mx-auto">
                    Integre los servicios financieros que su empresa necesita mediante una única plataforma moderna, segura y preparada para operar en tiempo real.
                </p>
            </div>
        </div>

        <!-- Fila Inferior: 3 Tarjetas Grandes Agrupadas -->
        <div class="row g-4 row-cols-1 row-cols-lg-3">

            <!-- Tarjeta 1: Transferencias y cuentas -->
            <div class="col">
                <div class="service-card h-100 bg-white p-4 p-lg-5 shadow-sm border border-light-subtle position-relative" style="border-radius:32px;">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-4">
                        <i class="bi bi-bank2 fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Transferencias y cuentas</h4>
                    <p class="text-muted mb-3">Centralizá el movimiento de dinero de tu empresa en una sola cuenta.</p>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-4">
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-wellpay"></i><span>Cuenta IBAN</span></li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-wellpay"></i><span>Pago Inmediato (PIN)</span></li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-wellpay"></i><span>Débito en Tiempo Real (DTR)</span></li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-wellpay"></i><span>SINPE Móvil</span></li>
                    </ul>
                    <a asp-controller="Servicios" asp-action="Index" asp-fragment="creacion-cuentas-iban" class="stretched-link text-primary-custom fw-semibold d-inline-flex align-items-center gap-1 text-decoration-none">
                        Saber más <i class="bi bi-chevron-right fs-8"></i>
                    </a>
                </div>
            </div>

            <!-- Tarjeta 2: Pagos empresariales -->
            <div class="col">
                <div class="service-card h-100 bg-white p-4 p-lg-5 shadow-sm border border-light-subtle position-relative" style="border-radius:32px;">
                    <div class="service-icon-shape bg-light-blue text-primary-custom rounded-circle mb-4">
                        <i class="bi bi-send-check-fill fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Pagos empresariales</h4>
                    <p class="text-muted mb-3">Pagá a proveedores y cobrá a tus clientes a cualquier escala.</p>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-4">
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-primary-custom"></i><span>Pagos masivos</span></li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-primary-custom"></i><span>Cobros masivos</span></li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-primary-custom"></i><span>Cobros con tarjeta</span></li>
                    </ul>
                    <a asp-controller="Servicios" asp-action="Index" asp-fragment="pagos-masivos" class="stretched-link text-primary-custom fw-semibold d-inline-flex align-items-center gap-1 text-decoration-none">
                        Saber más <i class="bi bi-chevron-right fs-8"></i>
                    </a>
                </div>
            </div>

            <!-- Tarjeta 3: Pagos con tarjeta -->
            <div class="col">
                <div class="service-card h-100 bg-white p-4 p-lg-5 shadow-sm border border-light-subtle position-relative" style="border-radius:32px;">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-4">
                        <i class="bi bi-credit-card-2-front-fill fs-2"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">Pagos con tarjeta</h4>
                    <p class="text-muted mb-3">Aceptá pagos con tarjeta de la forma que mejor se adapte a tu negocio.</p>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-4">
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-wellpay"></i><span>Checkout</span></li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-wellpay"></i><span>Link de pago</span></li>
                        <li class="d-flex align-items-center gap-2"><i class="bi bi-check-circle-fill text-wellpay"></i><span>Cargos recurrentes</span></li>
                    </ul>
                    <a asp-controller="Servicios" asp-action="Index" asp-fragment="checkout" class="stretched-link text-primary-custom fw-semibold d-inline-flex align-items-center gap-1 text-decoration-none">
                        Saber más <i class="bi bi-chevron-right fs-8"></i>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>


