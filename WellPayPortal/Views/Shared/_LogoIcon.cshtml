<svg viewBox="0 0 64 64" class="wellpay-logo-icon" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Well-Pay" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
    <defs>
        <linearGradient id="wpLogoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="var(--wellpay-green)" />
            <stop offset="100%" stop-color="var(--wellpay-blue)" />
        </linearGradient>
    </defs>

    <!-- Cuerpo tipo tarjeta/documento -->
    <rect x="6" y="4" width="36" height="56" rx="8" fill="none" stroke="url(#wpLogoGradient)" stroke-width="4" />

    <!-- Ícono pequeño superior -->
    <rect x="14" y="14" width="10" height="10" rx="3" fill="url(#wpLogoGradient)" />

    <!-- Líneas de texto -->
    <rect x="14" y="34" width="16" height="4" rx="2" fill="url(#wpLogoGradient)" />
    <rect x="14" y="42" width="12" height="4" rx="2" fill="url(#wpLogoGradient)" />

    <!-- Ondas de señal (contactless) -->
    <path class="wp-wave wp-wave-1" d="M46 40 A10 10 0 0 0 46 24" fill="none" stroke="url(#wpLogoGradient)" stroke-width="4" stroke-linecap="round" />
    <path class="wp-wave wp-wave-2" d="M52 46 A18 18 0 0 0 52 18" fill="none" stroke="url(#wpLogoGradient)" stroke-width="4" stroke-linecap="round" />
    <path class="wp-wave wp-wave-3" d="M58 52 A26 26 0 0 0 58 12" fill="none" stroke="url(#wpLogoGradient)" stroke-width="4" stroke-linecap="round" />
</svg>
