@{
    ViewData["Title"] = "Desarrolladores";
}

<!-- MINI HERO DESARROLLADORES -->
<section id="desarrolladores" class="py-5 bg-white position-relative overflow-hidden">
    <div class="glow-shape glow-top-right"></div>
    <div class="glow-shape glow-bottom-right"></div>

    <div class="container py-4 position-relative text-center" style="z-index: 2;">
        <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
            <i class="bi bi-code-slash"></i>
            <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;">Desarrolladores</small>
        </div>

        <h1 class="display-5 fw-extrabold text-dark mb-3 lh-sm">
            Todo lo que necesitás para <span class="text-wellpay">integrar Well-Pay</span>
        </h1>

        <p class="lead text-secondary fs-6 fw-normal mx-auto" style="max-width: 700px;">
            Documentación, API, ambiente de pruebas y guías paso a paso para conectar tu negocio
            a la infraestructura de pagos de Well-Pay.
        </p>
    </div>
</section>

