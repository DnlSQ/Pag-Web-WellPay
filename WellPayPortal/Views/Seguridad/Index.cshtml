<!-- ============================================================
     PCI DSS
     ============================================================ -->
<section id="pci-dss" class="py-5 position-relative overflow-hidden bg-light-subtle">
    <div class="container pt-3 pb-5 position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;" data-es="PCI DSS" data-en="PCI DSS">PCI DSS</small>
                </div>

                <h2 class="display-6 fw-extrabold text-dark mb-4 lh-sm">
                    <span data-es="Cumplimiento " data-en="Compliance with ">Cumplimiento </span><span class="text-primary-custom" data-es="PCI DSS" data-en="PCI DSS">PCI DSS</span>
                </h2>

                <p class="text-secondary fs-6 fw-normal mb-3" data-es="Well-Pay opera bajo los requisitos de PCI DSS (Payment Card Industry Data Security Standard), el estándar desarrollado por el Consejo de Normas de Seguridad de la Industria de Tarjetas de Pago para proteger la información de tarjetahabientes en cada transacción." data-en="Well-Pay operates under PCI DSS (Payment Card Industry Data Security Standard) requirements, the standard developed by the Payment Card Industry Security Standards Council to protect cardholder information in every transaction.">
                    Well-Pay opera bajo los requisitos de <strong>PCI DSS</strong> (Payment Card Industry Data
                    Security Standard), el estándar desarrollado por el Consejo de Normas de Seguridad de la
                    Industria de Tarjetas de Pago para proteger la información de tarjetahabientes en cada
                    transacción.
                </p>

                <p class="text-secondary fs-6 fw-normal mb-4" data-es="Aplicamos los controles correspondientes a la versión más actualizada de la norma, lo que nos permite mantener altos estándares de protección frente a los riesgos asociados al manejo de datos de pago." data-en="We apply the controls corresponding to the most current version of the standard, which allows us to maintain high protection standards against risks associated with payment data handling.">
                    Aplicamos los controles correspondientes a la <strong>versión más actualizada de la norma</strong>,
                    lo que nos permite mantener altos estándares de protección frente a los riesgos asociados
                    al manejo de datos de pago.
                </p>
            </div>

            <div class="col-lg-6">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 32px; cursor: pointer;" data-bs-toggle="modal" data-bs-target="#pciDssModal">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                        <i class="bi bi-patch-check-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2" data-es="¿Qué protege PCI DSS?" data-en="What does PCI DSS protect?">¿Qué protege PCI DSS?</h5>
                    <p class="text-muted mb-3" data-es="Establece requisitos y buenas prácticas para las empresas que manejan, procesan o almacenan datos de tarjetas de crédito y débito, reduciendo el riesgo de robo de identidad, fraude y uso indebido de la información." data-en="It establishes requirements and best practices for companies that handle, process, or store credit and debit card data, reducing the risk of identity theft, fraud, and misuse of information.">
                        Establece requisitos y buenas prácticas para las empresas que manejan, procesan o
                        almacenan datos de tarjetas de crédito y débito, reduciendo el riesgo de robo de
                        identidad, fraude y uso indebido de la información.
                    </p>
                    <span class="fw-bold pci-link-arrow d-inline-flex align-items-center gap-1" data-es="Más información " data-en="More information ">
                        Más información <i class="bi bi-arrow-right"></i>
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MODAL - MÁS INFORMACIÓN PCI DSS -->
<div class="modal fade modal-stripe" id="pciDssModal" tabindex="-1" aria-labelledby="pciDssModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden position-relative p-2 p-md-4">

            <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center">
                <h4 class="modal-title fw-bold text-dark" id="pciDssModalLabel" data-es="Certificación PCI DSS" data-en="PCI DSS Certification">Certificación PCI DSS</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body pt-2">
                <div class="row align-items-center g-4 mb-2">
                    <div class="col-12">
                        <!-- TODO: confirmar con el equipo el año de certificación real y la periodicidad exacta de recertificación antes de publicar -->
                        <p class="text-secondary mb-3" data-es="PCI DSS (Payment Card Industry Data Security Standard) es el estándar creado por el Consejo de Normas de Seguridad de la Industria de Tarjetas de Pago para proteger la información confidencial de tarjetahabientes: número de tarjeta, fecha de vencimiento y código de seguridad. Su cumplimiento se valida mediante un proceso de certificación y recertificación periódica." data-en="PCI DSS (Payment Card Industry Data Security Standard) is the standard created by the Payment Card Industry Security Standards Council to protect confidential cardholder information: card number, expiration date, and security code. Compliance is validated through a certification and periodic re-certification process.">
                            PCI DSS (Payment Card Industry Data Security Standard) es el estándar creado por el
                            Consejo de Normas de Seguridad de la Industria de Tarjetas de Pago para proteger la
                            información confidencial de tarjetahabientes: número de tarjeta, fecha de vencimiento
                            y código de seguridad. Su cumplimiento se valida mediante un proceso de certificación
                            y recertificación periódica.
                        </p>
                    </div>
                </div>

                <p class="text-secondary mb-4" data-es="Cumplir con esta norma no solo protege al consumidor final: también ayuda a las empresas a prevenir incidentes de seguridad que podrían derivar en pérdida de datos o daño reputacional, mediante controles como firewalls, cifrado en la transmisión de datos, restricción de acceso a información sensible y monitoreo continuo de los sistemas." data-en="Complying with this standard not only protects the end consumer: it also helps companies prevent security incidents that could lead to data loss or reputational damage, through controls such as firewalls, data transmission encryption, access restrictions to sensitive information, and continuous system monitoring.">
                    Cumplir con esta norma no solo protege al consumidor final: también ayuda a las empresas
                    a prevenir incidentes de seguridad que podrían derivar en pérdida de datos o daño
                    reputacional, mediante controles como firewalls, cifrado en la transmisión de datos,
                    restricción de acceso a información sensible y monitoreo continuo de los sistemas.
                </p>

                <h6 class="fw-bold text-dark mb-3" data-es="Beneficios de la certificación" data-en="Benefits of certification">Beneficios de la certificación</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-6 d-flex gap-2">
                        <i class="bi bi-check-circle-fill text-wellpay mt-1"></i>
                        <div>
                            <strong class="d-block text-dark" data-es="Protección de datos confidenciales" data-en="Protection of confidential data">Protección de datos confidenciales</strong>
                            <span class="text-muted small" data-es="Reduce el riesgo de robo de identidad y fraude con tarjetas." data-en="Reduces the risk of identity theft and card fraud.">Reduce el riesgo de robo de identidad y fraude con tarjetas.</span>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex gap-2">
                        <i class="bi bi-check-circle-fill text-wellpay mt-1"></i>
                        <div>
                            <strong class="d-block text-dark" data-es="Menos riesgo legal" data-en="Less legal risk">Menos riesgo legal</strong>
                            <span class="text-muted small" data-es="Ayuda a evitar sanciones asociadas a brechas de datos de pago." data-en="Helps avoid penalties associated with payment data breaches.">Ayuda a evitar sanciones asociadas a brechas de datos de pago.</span>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex gap-2">
                        <i class="bi bi-check-circle-fill text-wellpay mt-1"></i>
                        <div>
                            <strong class="d-block text-dark" data-es="Mayor confianza del cliente" data-en="Greater customer trust">Mayor confianza del cliente</strong>
                            <span class="text-muted small" data-es="Demuestra un compromiso real con la seguridad de sus datos." data-en="Demonstrates a real commitment to the security of their data.">Demuestra un compromiso real con la seguridad de sus datos.</span>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex gap-2">
                        <i class="bi bi-check-circle-fill text-wellpay mt-1"></i>
                        <div>
                            <strong class="d-block text-dark" data-es="Mejor reputación" data-en="Better reputation">Mejor reputación</strong>
                            <span class="text-muted small" data-es="Sostiene una imagen sólida y confiable frente al mercado." data-en="Maintains a solid and reliable image in the market.">Sostiene una imagen sólida y confiable frente al mercado.</span>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex gap-2">
                        <i class="bi bi-check-circle-fill text-wellpay mt-1"></i>
                        <div>
                            <strong class="d-block text-dark" data-es="Prevención de incidentes" data-en="Incident prevention">Prevención de incidentes</strong>
                            <span class="text-muted small" data-es="Reduce la probabilidad de brechas de datos o ataques." data-en="Reduces the likelihood of data breaches or attacks.">Reduce la probabilidad de brechas de datos o ataques.</span>
                        </div>
                    </div>
                </div>

                <p class="text-muted small fst-italic mb-0" data-es="El proceso de certificación PCI DSS incluye una auditoría periódica realizada por un QSA (Qualified Security Assessor) autorizado por el PCI Council." data-en="The PCI DSS certification process includes a periodic audit performed by a QSA (Qualified Security Assessor) authorized by the PCI Council.">
                    El proceso de certificación PCI DSS incluye una auditoría periódica realizada por un
                    QSA (Qualified Security Assessor) autorizado por el PCI Council.
                </p>
            </div>

            <div class="modal-footer border-0 pt-0 text-center justify-content-center">
