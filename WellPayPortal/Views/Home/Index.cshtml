@{
    ViewData["Title"] = "Inicio";
}

<!-- SECCIÓN HERO PRINCIPAL CON GLOW -->
<section class="py-3 py-lg-4 position-relative overflow-hidden">
    <div class="container">
        <div class="row align-items-center g-4">

            <!-- COLUMNA IZQUIERDA: Textos y Botones -->
            <div class="col-lg-5">
                <!-- Badge Verde -->
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <span class="dot-indicator"></span>
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px;">SOLUCIONES FINANCIERAS PARA EMPRESAS</small>
                </div>

                <!-- Título Principal -->
                <h1 class="display-5 fw-extrabold text-dark mb-3 lh-sm">
                    Conectá tu empresa con el sistema financiero <br class="d-none d-md-inline" />
                    <span class="text-primary-custom">de Costa Rica.</span>
                </h1>

                <!-- Subtítulo -->
                <p class="lead text-secondary mb-4 fs-6 fw-normal">
                    Gestioná cuentas IBAN, pagos inmediatos, SINPE, cobros con tarjeta y conciliación
                    desde una sola plataforma.
                </p>

                <!-- Botones de Acción -->
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <button type="button" class="btn btn-wellpay btn-lg px-4 py-2 fs-6 fw-bold rounded-3 shadow-sm btn-full-mobile" data-bs-toggle="modal" data-bs-target="#afiliacionModal">
                        Solicitar afiliación
                    </button>
                </div>

                <!-- Tres Características (Iconos abajo) -->
                <div class="row g-2 pt-1">
                    <div class="col-sm-4 d-flex align-items-center gap-2">
                        <div class="icon-shape bg-light rounded-3 p-2 text-success">
                            <i class="bi bi-lightning-charge-fill fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-7 lh-1">En tiempo real</div>
                            <small class="text-muted" style="font-size: 0.72rem;">Operaciones 24/7</small>
                        </div>
                    </div>

                    <div class="col-sm-4 d-flex align-items-center gap-2">
                        <div class="icon-shape bg-light rounded-3 p-2 text-success">
                            <i class="bi bi-shield-check fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-7 lh-1">Seguro</div>
                            <small class="text-muted" style="font-size: 0.72rem;">Infraestructura robusta</small>
                        </div>
                    </div>

                    <div class="col-sm-4 d-flex align-items-center gap-2">
                        <div class="icon-shape bg-light rounded-3 p-2 text-success">
                            <i class="bi bi-code-slash fs-5"></i>
                        </div>
                        <div>
                            <div class="fw-bold fs-7 lh-1">Fácil integración</div>
                            <small class="text-muted" style="font-size: 0.72rem;">API moderna y flexible</small>
                        </div>
                    </div>
                </div>
            </div> <!-- Fin Columna Izquierda -->
            <!-- COLUMNA DERECHA: Dashboard con Resplandor (Glow) -->
            <div class="col-lg-7 position-relative">
                <div class="glow-shape glow-top-right"></div>
                <div class="glow-shape glow-bottom-right"></div>

                <div class="dashboard-mockup-wrap">
                    <!-- Chips flotantes: sensación de producto en vivo -->
                    <div class="dashboard-chip dashboard-chip-top d-none d-md-flex">
                        <i class="bi bi-check-circle-fill text-wellpay"></i>
                        <span>Pago recibido</span>
                    </div>
                    <div class="dashboard-chip dashboard-chip-bottom d-none d-md-flex">
                        <i class="bi bi-check-circle-fill text-primary-custom"></i>
                        <span>SINPE confirmado</span>
                    </div>

                    <div class="dashboard-card-mockup shadow-lg rounded-4 overflow-hidden border border-light position-relative" style="z-index: 2;">
                        <div class="row g-0">

                        <!-- Sidebar Oscuro -->
                        <div class="col-4 bg-navy p-3 text-white d-flex flex-column justify-content-between">
                            <div>
                                <div class="fw-bold fs-6 mb-3 d-flex align-items-center gap-2">
                                    <i class="bi bi-credit-card-2-front text-wellpay fs-5"></i>
                                    <span>WELL-PAY</span>
                                </div>

                                <div class="d-grid gap-1 dashboard-buttons">
                                    <a asp-controller="Home" asp-action="Index" class="btn btn-dashboard-item active text-start text-white">
                                        <i class="bi bi-house me-2"></i>Inicio
                                    </a>
                                    <a asp-controller="Home" asp-action="Index" class="btn btn-dashboard-item text-start text-white-50">
                                        <i class="bi bi-wallet2 me-2"></i>Cuentas
                                    </a>
                                    <a asp-controller="Home" asp-action="Index" class="btn btn-dashboard-item text-start text-white-50">
                                        <i class="bi bi-arrow-down-left-square me-2"></i>Pagos
                                    </a>
                                    <a asp-controller="Home" asp-action="Index" class="btn btn-dashboard-item text-start text-white-50">
                                        <i class="bi bi-arrow-up-right-square me-2"></i>Cobros
                                    </a>
                                    <a asp-controller="Home" asp-action="Index" class="btn btn-dashboard-item text-start text-white-50">
                                        <i class="bi bi-bar-chart me-2"></i>Reportes
                                    </a>
                                    <a asp-controller="Home" asp-action="Index" class="btn btn-dashboard-item text-start text-white-50">
                                        <i class="bi bi-code-slash me-2"></i>Desarrollo
                                    </a>
                                    <a asp-controller="Home" asp-action="Index" class="btn btn-dashboard-item text-start text-white-50">
                                        <i class="bi bi-gear me-2"></i>Ajustes
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Panel Blanco -->
                        <div class="col-8 bg-white p-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold m-0 text-dark">Resumen</h6>
                                <div class="d-flex gap-2 text-muted">
                                    <i class="bi bi-bell hover-pointer"></i>
                                    <i class="bi bi-person-circle hover-pointer"></i>
                                </div>
                            </div>

                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <div class="bg-light p-2 rounded-3 border border-light-subtle">
                                        <small class="text-muted d-block" style="font-size:0.65rem;">Saldo disponible</small>
                                        <strong class="fs-6 fw-extrabold text-dark">₡ 12.458.750,00</strong>
                                        <small class="d-block text-muted" style="font-size:0.6rem;">Colones</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-light p-2 rounded-3 border border-light-subtle">
                                        <small class="text-muted d-block" style="font-size:0.65rem;">Movimientos hoy</small>
                                        <strong class="fs-6 fw-extrabold text-dark">28</strong>
                                        <small class="d-block text-muted" style="font-size:0.6rem;">Transacciones</small>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <small class="fw-bold text-dark" style="font-size:0.75rem;">Últimas transacciones</small>
                                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-primary fw-semibold" style="font-size:0.65rem;">Ver todas</a>
                            </div>

                            <div class="d-flex flex-column gap-1" style="font-size: 0.7rem;">
                                <div class="d-flex align-items-center justify-content-between p-1 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-success-subtle text-success p-1 rounded-circle"><i class="bi bi-arrow-up-right"></i></span>
                                        <div>
                                            <div class="fw-bold text-dark">Pago recibido - Cliente A</div>
                                            <small class="text-muted" style="font-size: 0.6rem;">Hoy, 10:45 a. m.</small>
                                        </div>
                                    </div>
                                    <span class="fw-bold text-success">+ ₡125.000,00</span>
                                </div>

                                <div class="d-flex align-items-center justify-content-between p-1 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-danger-subtle text-danger p-1 rounded-circle"><i class="bi bi-arrow-down-left"></i></span>
                                        <div>
                                            <div class="fw-bold text-dark">Transferencia - Proveedor B</div>
                                            <small class="text-muted" style="font-size: 0.6rem;">Hoy, 9:30 a. m.</small>
                                        </div>
                                    </div>
                                    <span class="fw-bold text-danger">- ₡75.000,00</span>
                                </div>

                                <div class="d-flex align-items-center justify-content-between p-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-success-subtle text-success p-1 rounded-circle"><i class="bi bi-arrow-up-right"></i></span>
                                        <div>
                                            <div class="fw-bold text-dark">SINPE Móvil - Cliente C</div>
                                            <small class="text-muted" style="font-size: 0.6rem;">Ayer, 4:15 p. m.</small>
                                        </div>
                                    </div>
                                    <span class="fw-bold text-success">+ ₡300.000,00</span>
                                </div>
                            </div>

                        </div>
                    </div>
                    </div>
                </div>
            </div> <!-- Fin Columna Derecha -->

        </div>
    </div>
</section>
