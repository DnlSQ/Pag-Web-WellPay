                                        <i class="bi bi-arrow-down-left-square me-2"></i>Pagos
                                    </a>
                                    <a asp-controller="Home" asp-action="Index" class="btn btn-dashboard-item text-start text-white-50" data-es="Cobros" data-en="Collections">
                                        <i class="bi bi-arrow-up-right-square me-2"></i>Cobros
                                    </a>
                                    <a asp-controller="Home" asp-action="Index" class="btn btn-dashboard-item text-start text-white-50" data-es="Reportes" data-en="Reports">
