@{
    ViewData["Title"] = "Nosotros";
}

<!-- MINI HERO NOSOTROS -->
<section class="py-5 bg-white position-relative overflow-hidden hero-fade-bottom">
    <div class="container py-3 position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;" data-es="Nosotros" data-en="About Us">Nosotros</small>
                </div>

                <h1 class="display-5 fw-extrabold text-dark mb-3 lh-sm">
                    <span data-es="Conocé a" data-en="Meet">Conocé a</span> <span class="text-primary-custom" data-es="Well-Pay" data-en="Well-Pay">Well-Pay</span>
                </h1>

                <p class="lead text-secondary fs-6 fw-normal" data-es="Quiénes somos, hacia dónde vamos y cómo trabajamos para impulsar el sistema financiero de Costa Rica." data-en="Who we are, where we're headed, and how we work to drive Costa Rica's financial system.">
                    Quiénes somos, hacia dónde vamos y cómo trabajamos para impulsar el sistema financiero de Costa Rica.
                </p>
            </div>

            <div class="col-lg-6 d-none d-lg-block position-relative">
                <div class="glow-shape glow-top-right glow-half"></div>
                <div class="glow-shape glow-bottom-right glow-half"></div>

                <div class="dashboard-card-mockup shadow-lg rounded-4 overflow-hidden border border-light p-4 bg-white mx-auto position-relative" style="max-width: 340px; z-index: 2;">
                    <small class="text-muted d-block mb-3" data-es="Lo que nos define" data-en="What defines us">Lo que nos define</small>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="pillar-icon-sm bg-light-green text-wellpay flex-shrink-0"><i class="bi bi-lightning-charge-fill"></i></span>
                        <div>
                            <span class="fw-bold text-dark d-block" data-es="Agilidad" data-en="Agility">Agilidad</span>
                            <span class="text-muted small" data-es="Resolvemos rápido, sin trámites innecesarios." data-en="We solve fast, without unnecessary procedures.">Resolvemos rápido, sin trámites innecesarios.</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="pillar-icon-sm bg-light-blue text-primary-custom flex-shrink-0"><i class="bi bi-people-fill"></i></span>
                        <div>
                            <span class="fw-bold text-dark d-block" data-es="Cercanía" data-en="Closeness">Cercanía</span>
                            <span class="text-muted small" data-es="Acompañamos a cada negocio como si fuera propio." data-en="We accompany each business as if it were our own.">Acompañamos a cada negocio como si fuera propio.</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="pillar-icon-sm bg-light-green text-wellpay flex-shrink-0"><i class="bi bi-graph-up-arrow"></i></span>
                        <div>
                            <span class="fw-bold text-dark d-block" data-es="Innovación" data-en="Innovation">Innovación</span>
                            <span class="text-muted small" data-es="Mejoramos constantemente nuestra plataforma." data-en="We constantly improve our platform.">Mejoramos constantemente nuestra plataforma.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     QUIÉNES SOMOS (incluye historia, misión, visión y valores)
     ============================================================ -->
<section id="quienes-somos" class="py-5 bg-white position-relative overflow-hidden">
    <div class="container pt-3 pb-5 position-relative" style="z-index: 2;">

        <div class="row align-items-center g-5 mb-5">
            <div class="col-lg-6">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;" data-es="Quiénes somos" data-en="Who We Are">Quiénes somos</small>
                </div>

                <h2 class="display-5 fw-extrabold text-dark mb-4 lh-sm">
                    <span data-es="Nuestra" data-en="Our">Nuestra</span> <span class="text-primary-custom" data-es="historia y trayectoria" data-en="history and trajectory">historia y trayectoria</span>
                </h2>

                <p class="text-secondary fs-6 fw-normal mb-3" data-es="Well-Pay nace con el objetivo de simplificar la forma en que las empresas costarricenses reciben y gestionan sus pagos. Desde nuestros inicios, trabajamos de la mano de comercios, profesionales independientes y desarrolladores para construir una infraestructura de pagos moderna, segura y adaptada a la realidad del mercado local." data-en="Well-Pay was born to simplify how Costa Rican companies receive and manage their payments. Since our beginning, we work hand in hand with merchants, independent professionals, and developers to build a modern, secure payment infrastructure adapted to the local market.">
                    Well-Pay nace con el objetivo de simplificar la forma en que las empresas costarricenses reciben y gestionan sus pagos. Desde nuestros inicios, trabajamos de la mano de comercios, profesionales independientes y desarrolladores para construir una infraestructura de pagos moderna, segura y adaptada a la realidad del mercado local.
                </p>

                <p class="text-secondary fs-6 fw-normal mb-0" data-es="Hoy seguimos creciendo junto a nuestros clientes, incorporando nuevas soluciones financieras y tecnológicas que acompañan a cada negocio en su día a día." data-en="Today we continue growing alongside our customers, incorporating new financial and technological solutions that support every business day by day.">
                    Hoy seguimos creciendo junto a nuestros clientes, incorporando nuevas soluciones financieras y tecnológicas que acompañan a cada negocio en su día a día.
                </p>
            </div>

            <div class="col-lg-6">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 32px; cursor: pointer;"
                     data-bs-toggle="modal" data-bs-target="#valoresModal">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                        <i class="bi bi-heart-fill fs-4"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-3" data-es="Valores" data-en="Values">Valores</h4>
                    <p class="text-muted mb-0" data-es="Seguridad, agilidad, cercanía e innovación guían todo lo que hacemos." data-en="Security, agility, closeness, and innovation guide everything we do.">Seguridad, agilidad, cercanía e innovación guían todo lo que hacemos.</p>
                </div>
            </div>
        </div>

        <!-- MISIÓN Y VISIÓN -->
        <div id="mision" class="row g-4 row-cols-1 row-cols-md-2">
            <div class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 32px; cursor: pointer;"
                     data-bs-toggle="modal" data-bs-target="#misionModal">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                        <i class="bi bi-bullseye fs-4"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-3" data-es="Misión" data-en="Mission">Misión</h4>
                    <p class="text-muted mb-0" data-es="Facilitar el acceso de las empresas costarricenses a herramientas de pago seguras, ágiles y en tiempo real, impulsando su crecimiento y competitividad." data-en="To provide Costa Rican companies with access to safe, agile, and real-time payment tools, driving their growth and competitiveness.">
                        Facilitar el acceso de las empresas costarricenses a herramientas de pago seguras, ágiles y en tiempo real, impulsando su crecimiento y competitividad.
                    </p>
                </div>
            </div>

            <div id="vision" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 32px; cursor: pointer;"
                     data-bs-toggle="modal" data-bs-target="#visionModal">
                    <div class="service-icon-shape bg-light-blue text-primary-custom rounded-circle mb-3">
                        <i class="bi bi-eye-fill fs-4"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-3" data-es="Visión" data-en="Vision">Visión</h4>
                    <p class="text-muted mb-0" data-es="Ser la plataforma de pagos de referencia en Costa Rica, reconocida por su seguridad, innovación y cercanía con cada cliente." data-en="To be the leading payment platform in Costa Rica, recognized for its security, innovation, and closeness with every customer.">
                        Ser la plataforma de pagos de referencia en Costa Rica, reconocida por su seguridad, innovación y cercanía con cada cliente.
                    </p>
                </div>
            </div>
        </div>


    </div>
</section>

        <!-- MODAL - MISIÓN -->
        <div class="modal fade modal-stripe" id="misionModal" tabindex="-1" aria-labelledby="misionModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden position-relative p-2 p-md-4">
                    <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center">
                        <h4 class="modal-title fw-bold text-dark" id="misionModalLabel" data-es="Nuestra Misión" data-en="Our Mission">Nuestra Misión</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-2">
                        <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                            <i class="bi bi-bullseye fs-4"></i>
                        </div>
                        <p class="text-secondary mb-0" data-es="Facilitar el acceso de las empresas costarricenses a herramientas de pago seguras, ágiles y en tiempo real, impulsando su crecimiento y competitividad. Trabajamos cada día para que cualquier negocio, sin importar su tamaño, pueda cobrar y pagar de forma simple, moderna y confiable." data-en="To provide Costa Rican companies with access to safe, agile, and real-time payment tools, driving their growth and competitiveness. We work every day so that any business, regardless of size, can collect and pay in a simple, modern, and reliable way.">
                            Facilitar el acceso de las empresas costarricenses a herramientas de pago seguras, ágiles y en tiempo real, impulsando su crecimiento y competitividad. Trabajamos cada día para que cualquier negocio, sin importar su tamaño, pueda cobrar y pagar de forma simple, moderna y confiable.
                        </p>
                    </div>
                    <div class="modal-footer border-0 pt-0 text-center justify-content-center">
                        <button type="button" class="btn btn-wellpay fw-bold px-4 py-2 rounded-pill" data-bs-dismiss="modal" data-es="Entendido" data-en="Got it">Entendido</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL - VISIÓN -->
        <div class="modal fade modal-stripe" id="visionModal" tabindex="-1" aria-labelledby="visionModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden position-relative p-2 p-md-4">
                    <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center">
                        <h4 class="modal-title fw-bold text-dark" id="visionModalLabel" data-es="Nuestra Visión" data-en="Our Vision">Nuestra Visión</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-2">
                        <div class="service-icon-shape bg-light-blue text-primary-custom rounded-circle mb-3">
                            <i class="bi bi-eye-fill fs-4"></i>
                        </div>
                        <p class="text-secondary mb-0" data-es="Ser la plataforma de pagos de referencia en Costa Rica, reconocida por su seguridad, innovación y cercanía con cada cliente. Aspiramos a que cada vez más negocios del país elijan a Well-Pay como su aliado de confianza para gestionar sus pagos." data-en="To be the leading payment platform in Costa Rica, recognized for its security, innovation, and closeness with every customer. We aspire for more and more businesses in the country to choose Well-Pay as their trusted partner for managing their payments.">
                            Ser la plataforma de pagos de referencia en Costa Rica, reconocida por su seguridad, innovación y cercanía con cada cliente. Aspiramos a que cada vez más negocios del país elijan a Well-Pay como su aliado de confianza para gestionar sus pagos.
                        </p>
                    </div>
                    <div class="modal-footer border-0 pt-0 text-center justify-content-center">
                        <button type="button" class="btn btn-wellpay fw-bold px-4 py-2 rounded-pill" data-bs-dismiss="modal" data-es="Entendido" data-en="Got it">Entendido</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL - VALORES -->
        <div class="modal fade modal-stripe" id="valoresModal" tabindex="-1" aria-labelledby="valoresModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden position-relative p-2 p-md-4">
                    <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center">
                        <h4 class="modal-title fw-bold text-dark" id="valoresModalLabel" data-es="Nuestros Valores" data-en="Our Values">Nuestros Valores</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-2">
                        <div class="row g-3">
                            <div class="col-md-6 d-flex gap-2">
                                <i class="bi bi-shield-check text-wellpay fs-5 mt-1"></i>
                                <div>
                                    <strong class="d-block text-dark" data-es="Seguridad" data-en="Security">Seguridad</strong>
                                    <span class="text-muted small" data-es="Protegemos cada operación y cada dato de nuestros clientes." data-en="We protect every transaction and every piece of our customers' data.">Protegemos cada operación y cada dato de nuestros clientes.</span>
                                </div>
                            </div>
                            <div class="col-md-6 d-flex gap-2">
                                <i class="bi bi-lightning-charge-fill text-wellpay fs-5 mt-1"></i>
                                <div>
                                    <strong class="d-block text-dark" data-es="Agilidad" data-en="Agility">Agilidad</strong>
                                    <span class="text-muted small" data-es="Resolvemos rápido, sin trámites innecesarios." data-en="We solve fast, without unnecessary procedures.">Resolvemos rápido, sin trámites innecesarios.</span>
                                </div>
                            </div>
                            <div class="col-md-6 d-flex gap-2">
                                <i class="bi bi-people-fill text-wellpay fs-5 mt-1"></i>
                                <div>
                                    <strong class="d-block text-dark" data-es="Cercanía" data-en="Closeness">Cercanía</strong>
                                    <span class="text-muted small" data-es="Acompañamos a cada negocio como si fuera propio." data-en="We accompany each business as if it were our own.">Acompañamos a cada negocio como si fuera propio.</span>
                                </div>
                            </div>
                            <div class="col-md-6 d-flex gap-2">
                                <i class="bi bi-graph-up-arrow text-wellpay fs-5 mt-1"></i>
                                <div>
                                    <strong class="d-block text-dark" data-es="Innovación" data-en="Innovation">Innovación</strong>
                                    <span class="text-muted small" data-es="Mejoramos constantemente nuestra plataforma y servicios." data-en="We constantly improve our platform and services.">Mejoramos constantemente nuestra plataforma y servicios.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 text-center justify-content-center">
                        <button type="button" class="btn btn-wellpay fw-bold px-4 py-2 rounded-pill" data-bs-dismiss="modal" data-es="Entendido" data-en="Got it">Entendido</button>
                    </div>
                </div>
            </div>
        </div>

<!-- ============================================================
     TRABAJA CON NOSOTROS (incluye Postulación)
     ============================================================ -->
<section id="trabaja-con-nosotros" class="py-5 position-relative overflow-hidden bg-light-subtle">

    <div class="container py-3 position-relative" style="z-index: 2;">

        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;" data-es="Trabaja con nosotros" data-en="Work with Us">Trabaja con nosotros</small>
                </div>

                <h2 class="display-5 fw-extrabold text-dark mb-4 lh-sm">
                    <span data-es="Construí el futuro de los" data-en="Build the future of">Construí el futuro de los</span> <span class="text-primary-custom" data-es="pagos en Costa Rica" data-en="payments in Costa Rica">pagos en Costa Rica</span>
                </h2>

                <p class="lead text-secondary fs-6 fw-normal" data-es="En Well-Pay creemos en equipos cercanos, ágiles y comprometidos con la innovación financiera. Si te apasiona la tecnología y los pagos, queremos conocerte." data-en="At Well-Pay we believe in close, agile teams committed to financial innovation. If you're passionate about technology and payments, we want to meet you.">
                    En Well-Pay creemos en equipos cercanos, ágiles y comprometidos con la innovación financiera. Si te apasiona la tecnología y los pagos, queremos conocerte.
                </p>
            </div>
        </div>

        <div id="postulacion" class="row justify-content-center">
            <div class="col-lg-6">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle text-center" style="border-radius: 32px;">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3 mx-auto">
                        <i class="bi bi-send-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2" data-es="Postulación" data-en="Application">Postulación</h5>
                    <p class="text-muted mb-3" data-es="Enviános tu currículum y contanos en qué área te gustaría aportar tu talento." data-en="Send us your resume and tell us which area you'd like to contribute your talent.">
                        Enviános tu currículum y contanos en qué área te gustaría aportar tu talento.
                    </p>
                    <button type="button"
                            class="btn btn-wellpay fw-bold px-4 py-2 rounded-pill shadow-sm"
                            data-bs-toggle="modal" data-bs-target="#postulacionModal">
                        <span data-es="Enviar mi CV" data-en="Send my CV">Enviar mi CV</span>
                        <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- MODAL - POSTULACIÓN -->
<div class="modal fade modal-stripe" id="postulacionModal" tabindex="-1" aria-labelledby="postulacionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden position-relative p-2 p-md-4">

            <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center">
                <h4 class="modal-title fw-bold text-dark" id="postulacionModalLabel" data-es="Postulación" data-en="Application">Postulación</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body pt-2">
                <p class="text-muted mb-4" data-es="Contanos un poco sobre vos y adjuntá tu currículum en PDF." data-en="Tell us a bit about yourself and attach your resume in PDF.">
                    Contanos un poco sobre vos y adjuntá tu currículum en PDF.
                </p>

                <form id="formPostulacion" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="postulacionNombre" class="form-label-custom" data-es="Nombre completo" data-en="Full name">Nombre completo</label>
                            <input type="text" name="Nombre" class="form-control form-control-stripe" id="postulacionNombre" required />
                        </div>

                        <div class="col-md-6">
                            <label for="postulacionTelefono" class="form-label-custom" data-es="Teléfono" data-en="Phone">Teléfono</label>
                            <input type="tel" name="Telefono" class="form-control form-control-stripe" id="postulacionTelefono" required />
                        </div>

                        <div class="col-12">
                            <label for="postulacionCorreo" class="form-label-custom" data-es="Correo electrónico" data-en="Email">Correo electrónico</label>
                            <input type="email" name="Correo" class="form-control form-control-stripe" id="postulacionCorreo" required />
                        </div>

                        <div class="col-12">
                            <label for="postulacionArea" class="form-label-custom" data-es="Área de interés" data-en="Area of interest">Área de interés</label>
                            <select name="AreaInteres" class="form-control form-control-stripe" id="postulacionArea" required>
                                <option value="" selected disabled data-es="Seleccioná un área..." data-en="Select an area...">Seleccioná un área...</option>
                                <option value="Desarrollo / Tecnología" data-es="Desarrollo / Tecnología" data-en="Development / Technology">Desarrollo / Tecnología</option>
                                <option value="Ventas / Comercial" data-es="Ventas / Comercial" data-en="Sales / Commercial">Ventas / Comercial</option>
                                <option value="Atención al cliente" data-es="Atención al cliente" data-en="Customer Service">Atención al cliente</option>
                                <option value="Administración / Finanzas" data-es="Administración / Finanzas" data-en="Administration / Finance">Administración / Finanzas</option>
                                <option value="Otra" data-es="Otra" data-en="Other">Otra</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label for="postulacionCv" class="form-label-custom" data-es="Currículum (PDF, máx. 5MB)" data-en="Resume (PDF, max 5MB)">Currículum (PDF, máx. 5MB)</label>
                            <input type="file" name="Cv" class="form-control form-control-stripe" id="postulacionCv" accept="application/pdf" required />
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-wellpay btn-lg fs-6 fw-bold py-3 rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <span data-es="Enviar postulación" data-en="Send application">Enviar postulación</span>
                            <i class="bi bi-arrow-right fs-5"></i>
                        </button>
                    </div>
                </form>
            </div>

            <div class="modal-footer border-0 pt-0 text-center justify-content-center">
                <small class="text-muted fs-8">
                    <i class="bi bi-shield-lock text-wellpay me-1"></i> <span data-es="Tu información y CV se envían de forma segura." data-en="Your information and resume are sent securely.">Tu información y CV se envían de forma segura.</span>
                </small>
            </div>

        </div>
    </div>
</div>

<!-- ============================================================
     CONTACTO
     ============================================================ -->
<section id="contacto" class="py-5 bg-white position-relative overflow-hidden">
    <div class="container pt-3 pb-5 position-relative" style="z-index: 2;">

        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;" data-es="Contacto" data-en="Contact">Contacto</small>
                </div>

                <h2 class="display-5 fw-extrabold text-dark mb-4 lh-sm">
                    <span data-es="Hablemos sobre" data-en="Let's talk about">Hablemos sobre</span> <span class="text-primary-custom" data-es="tu negocio" data-en="your business">tu negocio</span>
                </h2>

                <p class="lead text-secondary fs-6 fw-normal" data-es="Contactanos y te ayudamos a encontrar la solución de pagos que tu empresa necesita." data-en="Contact us and we'll help you find the payment solution your business needs.">
                    Contactanos y te ayudamos a encontrar la solución de pagos que tu empresa necesita.
                </p>
