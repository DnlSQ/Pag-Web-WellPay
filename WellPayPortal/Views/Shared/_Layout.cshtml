                                <li><a class="mobile-menu-link" asp-controller="Seguridad" asp-action="Index" asp-fragment="seguridad-wellpay" data-bs-dismiss="offcanvas" data-es="Seguridad en Well-Pay" data-en="Well-Pay Security">Seguridad en Well-Pay</a></li>
                                <li><a class="mobile-menu-link" asp-controller="Seguridad" asp-action="Index" asp-fragment="pci-dss" data-bs-dismiss="offcanvas" data-es="PCI DSS" data-en="PCI DSS">PCI DSS</a></li>
                                <li><a class="mobile-menu-link" asp-controller="Seguridad" asp-action="Index" asp-fragment="3d-secure" data-bs-dismiss="offcanvas" data-es="3-D Secure (3DS)" data-en="3-D Secure (3DS)">3-D Secure (3DS)</a></li>
                                <li><a class="mobile-menu-link" asp-controller="Seguridad" asp-action="Index" asp-fragment="sugef" data-bs-dismiss="offcanvas" data-es="SUGEF" data-en="SUGEF">SUGEF</a></li>
                                <li><a class="mobile-menu-link" asp-controller="Seguridad" asp-action="Index" asp-fragment="proteccion-datos" data-bs-dismiss="offcanvas" data-es="Protección de datos" data-en="Data Protection">Protección de datos</a></li>
                                <li><a class="mobile-menu-link" asp-controller="Seguridad" asp-action="Index" asp-fragment="seguridad-transacciones" data-bs-dismiss="offcanvas" data-es="Seguridad de las transacciones" data-en="Transaction Security">Seguridad de las transacciones</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Nosotros -->
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#mm-nosotros" data-es="Nosotros" data-en="About">
                            Nosotros
                        </button>
                    </h2>
                    <div id="mm-nosotros" class="accordion-collapse collapse" data-bs-parent="#mobileMenuAccordion">
                        <div class="accordion-body pt-0">
                            <ul class="list-unstyled mb-0">
                                <li><a class="mobile-menu-link" asp-controller="Nosotros" asp-action="Index" asp-fragment="quienes-somos" data-bs-dismiss="offcanvas" data-es="Quiénes somos" data-en="Who We Are">Quiénes somos</a></li>
                                <li><a class="mobile-menu-link" asp-controller="Nosotros" asp-action="Index" asp-fragment="mision" data-bs-dismiss="offcanvas" data-es="Misión" data-en="Mission">Misión</a></li>
                                <li><a class="mobile-menu-link" asp-controller="Nosotros" asp-action="Index" asp-fragment="vision" data-bs-dismiss="offcanvas" data-es="Visión" data-en="Vision">Visión</a></li>
                                <li><a class="mobile-menu-link" asp-controller="Nosotros" asp-action="Index" asp-fragment="postulacion" data-bs-dismiss="offcanvas" data-es="Postulación" data-en="Apply">Postulación</a></li>
                                <li><a class="mobile-menu-link" asp-controller="Nosotros" asp-action="Index" asp-fragment="contacto" data-bs-dismiss="offcanvas" data-es="Contacto" data-en="Contact">Contacto</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Acciones -->
            <div class="d-flex flex-column gap-2 p-3 border-top">
                <a href="https://qa.paymentpower.net/wellpay/portal/login" class="btn btn-outline-dark rounded-pill fw-bold" data-es="Iniciar sesión" data-en="Sign In">
                    Iniciar sesión
                </a>
                <button type="button" class="btn btn-wellpay fw-bold rounded-pill shadow-sm" data-bs-dismiss="offcanvas" data-bs-toggle="modal" data-bs-target="#afiliacionModal" data-es="Solicitar afiliación" data-en="Request Affiliation">
                    Solicitar afiliación
                </button>
            </div>

        </div>
    </div>

    <!-- Contenido de cada página -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-navy text-white pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-3 col-md-6">
                    <a class="navbar-brand d-flex align-items-center mb-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logos/logoBlanco.png" alt="Well-Pay" class="wellpay-logo-img" />
                    </a>
                    <p class="text-secondary fs-7 mb-0" data-es="Soluciones financieras para conectar a tu empresa con el sistema de pagos de Costa Rica." data-en="Financial solutions to connect your business with Costa Rica's payment system.">
                        Soluciones financieras para conectar a tu empresa con el sistema de pagos de Costa Rica.
                    </p>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="fw-bold text-white mb-3 text-center" data-es="Enlaces" data-en="Links">Enlaces</h6>
                    <div class="d-flex justify-content-center gap-5">
                        <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                            <li><a class="footer-link" asp-controller="Servicios" asp-action="Index" data-es="Servicios" data-en="Services">Servicios</a></li>
                            <li><a class="footer-link" asp-controller="Soluciones" asp-action="Index" data-es="Soluciones" data-en="Solutions">Soluciones</a></li>
                            <li><a class="footer-link" asp-controller="Desarrolladores" asp-action="Index" data-es="Desarrolladores" data-en="Developers">Desarrolladores</a></li>
                        </ul>
                        <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                            <li><a class="footer-link" asp-controller="Seguridad" asp-action="Index" data-es="Seguridad" data-en="Security">Seguridad</a></li>
                            <li><a class="footer-link" asp-controller="Nosotros" asp-action="Index" data-es="Nosotros" data-en="About">Nosotros</a></li>
                            <li><a class="footer-link" asp-controller="Home" asp-action="Privacy" data-es="Privacidad" data-en="Privacy">Privacidad</a></li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-white mb-3" data-es="Contacto" data-en="Contact">Contacto</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <li><a class="footer-link" href="mailto:contacto@well-pay.com"><i class="bi bi-envelope-fill me-2"></i>contacto@well-pay.com</a></li>
                        <li class="text-secondary"><i class="bi bi-geo-alt-fill me-2"></i><span data-es="San José, Costa Rica" data-en="San José, Costa Rica">San José, Costa Rica</span></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold text-white mb-3" data-es="Acceso" data-en="Access">Acceso</h6>
                    <a href="https://qa.paymentpower.net/wellpay/portal/login" class="btn btn-outline-light btn-sm rounded-pill px-3" data-es="Iniciar sesión" data-en="Sign In">
                        Iniciar sesión
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>

            </div>

            <hr class="border-secondary my-4" />

            <div class="text-center text-secondary fs-8" data-es="© [YEAR] Well-Pay. Todos los derechos reservados." data-en="© [YEAR] Well-Pay. All rights reserved.">
                &copy; @DateTime.Now.Year Well-Pay. Todos los derechos reservados.
            </div>
        </div>
    </footer>

    <!-- Barra fija inferior (solo móvil): WhatsApp + Solicitar afiliación -->
    <div class="mobile-bottom-bar d-lg-none">
        <a href="https://wa.me/50600000000" target="_blank" rel="noopener" class="btn btn-outline-dark rounded-pill fw-bold d-flex align-items-center justify-content-center gap-2" data-es="WhatsApp" data-en="WhatsApp">
            <i class="bi bi-whatsapp"></i> WhatsApp
        </a>
        <button type="button" class="btn btn-wellpay rounded-pill fw-bold" data-bs-toggle="modal" data-bs-target="#afiliacionModal" data-es="Solicitar afiliación" data-en="Request Affiliation">
            Solicitar afiliación
        </button>
    </div>

    <!-- MODAL FLOTANTE ESTILO STRIPE - SOLICITAR AFILIACIÓN (compartido en todas las páginas) -->
<div class="modal fade modal-stripe" id="afiliacionModal" tabindex="-1" aria-labelledby="afiliacionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden position-relative p-2 p-md-4">

            <!-- Encabezado con Logo y Botón de Cerrar -->
            <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center">
              <div class="d-flex align-items-center fw-extrabold text-dark fs-5">
                 <img src="~/images/logos/logo.png" alt="Well-Pay" class="wellpay-logo-img" />
              </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Cuerpo del Formulario -->
            <div class="modal-body pt-3">
                <div class="mb-4">
                    <h3 class="fw-extrabold text-dark m-0 fs-4" data-es="Solicitá tu afiliación" data-en="Request Your Affiliation">Solicitá tu afiliación</h3>
                    <p class="text-muted fs-7 mb-0" data-es="Completá los datos para iniciar el proceso de integración con tu empresa." data-en="Complete your information to start the integration process with your business.">Completá los datos para iniciar el proceso de integración con tu empresa.</p>
                </div>

                <form id="formAfiliacion">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <!-- Nombre -->
                        <div class="col-md-6">
                            <label for="nombre" class="form-label-custom" data-es="Nombre" data-en="Name">Nombre</label>
                            <input type="text" name="Nombre" class="form-control form-control-stripe" id="nombre" required />
                        </div>

                        <!-- Apellidos -->
                        <div class="col-md-6">
                            <label for="apellidos" class="form-label-custom" data-es="Apellidos" data-en="Last Name">Apellidos</label>
                            <input type="text" name="Apellidos" class="form-control form-control-stripe" id="apellidos" required />
                        </div>

                        <!-- Cédula / Identificación -->
                        <div class="col-md-6">
                            <label for="cedula" class="form-label-custom" data-es="Cédula Física / Jurídica / DIMEX" data-en="ID / Business License / DIMEX">Cédula Física / Jurídica / DIMEX</label>
                            <input type="text" name="Cedula" class="form-control form-control-stripe" id="cedula"
                                   inputmode="numeric" maxlength="12" placeholder="Solo números" required />
                            <input type="hidden" name="TipoIdentificacion" id="tipoIdentificacion" value="" />
                            <small class="form-text" id="cedulaTipoDetectado"></small>
                        </div>

                        <!-- Teléfono -->
                        <div class="col-md-6">
                            <label for="telefono" class="form-label-custom" data-es="Teléfono" data-en="Phone">Teléfono</label>
                            <input type="tel" name="Telefono" class="form-control form-control-stripe" id="telefono" required />
                        </div>

                        <!-- Correo Electrónico -->
                        <div class="col-12">
                            <label for="correo" class="form-label-custom" data-es="Correo electrónico" data-en="Email">Correo electrónico</label>
                            <input type="email" name="Correo" class="form-control form-control-stripe" id="correo" required />
                        </div>

                        <!-- Dirección -->
                        <div class="col-12">
                            <label for="direccion" class="form-label-custom" data-es="Dirección física" data-en="Physical Address">Dirección física</label>
                            <textarea name="Direccion" class="form-control form-control-stripe" id="direccion" rows="2" placeholder="Provincia, Cantón, Distrito y señas exactas..." required></textarea>
                        </div>
                        <!-- Representante legal (solo si la identificación es Cédula Jurídica) -->
                        <div class="col-12 d-none" id="bloqueRepresentanteLegal">
                            <hr class="my-2" />
                            <p class="fw-bold text-dark mb-2 fs-7" data-es="Representante legal" data-en="Legal Representative">
                                <i class="bi bi-person-badge text-wellpay me-1"></i> Representante legal
                            </p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="representanteNombre" class="form-label-custom" data-es="Nombre completo" data-en="Full Name">Nombre completo</label>
                                    <input type="text" name="RepresentanteNombre" class="form-control form-control-stripe" id="representanteNombre" />
                                </div>
                                <div class="col-md-3">
                                    <label for="representanteTipoIdentificacion" class="form-label-custom" data-es="Tipo de identificación" data-en="ID Type">Tipo de identificación</label>
                                    <select name="RepresentanteTipoIdentificacion" class="form-select form-control-stripe" id="representanteTipoIdentificacion">
                                        <option value="" data-es="Seleccionar..." data-en="Select...">Seleccionar...</option>
                                        <option value="Cedula" data-es="Cédula física" data-en="ID Card">Cédula física</option>
                                        <option value="Dimex" data-es="DIMEX" data-en="DIMEX">DIMEX</option>
                                        <option value="Pasaporte" data-es="Pasaporte" data-en="Passport">Pasaporte</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label for="representanteIdentificacion" class="form-label-custom" data-es="Número de identificación" data-en="ID Number">Número de identificación</label>
                                    <input type="text" name="RepresentanteIdentificacion" class="form-control form-control-stripe" id="representanteIdentificacion" placeholder="N.º de identificación" />
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- Botón Enviar -->
                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-wellpay btn-lg fs-6 fw-bold py-3 rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2" data-es="Enviar solicitud" data-en="Send Request">
                            <span>Enviar solicitud</span>
                            <i class="bi bi-arrow-right fs-5"></i>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Footer con Leyenda -->
            <div class="modal-footer border-0 pt-0 text-center justify-content-center">
                <small class="text-muted fs-8" data-es="Tus datos están protegidos con encriptación de grado bancario." data-en="Your data is protected with bank-grade encryption.">
                    <i class="bi bi-shield-lock text-wellpay me-1"></i> Tus datos están protegidos con encriptación de grado bancario.
                </small>
            </div>

        </div>
    </div>
</div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- i18n - Internacionalización -->
    <script src="~/js/i18n.js" asp-append-version="true"></script>

    <!-- Cierra el menú móvil automáticamente al tocar un enlace de navegación -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var navbarCollapse = document.getElementById('navbarMain');
            if (!navbarCollapse) return;

            var navLinks = navbarCollapse.querySelectorAll('a.nav-link:not(.dropdown-toggle), .dropdown-item');
            navLinks.forEach(function (link) {
                link.addEventListener('click', function () {
                    if (navbarCollapse.classList.contains('show')) {
                        var bsCollapse = bootstrap.Collapse.getInstance(navbarCollapse) || new bootstrap.Collapse(navbarCollapse);
                        bsCollapse.hide();
                    }
                });
            });
        });
    </script>

</body>
</html>
