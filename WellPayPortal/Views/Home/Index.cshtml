                                        <small class="d-block text-muted" style="font-size:0.6rem;" data-es="Colones" data-en="Colones">Colones</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-light p-2 rounded-3 border border-light-subtle">
                                        <small class="text-muted d-block" style="font-size:0.65rem;" data-es="Movimientos hoy" data-en="Transactions Today">Movimientos hoy</small>
