                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#mobileMenu"
                        aria-controls="mobileMenu"
                        aria-label="Abrir menú">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menú -->
                <div class="collapse navbar-collapse" id="navbarMain">

                    <!-- Navegación principal -->
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 fw-semibold">

                        <!-- Servicios -->
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle px-3"
                               href="#"
                               id="servicesDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false"
                               data-es="Servicios"
                               data-en="Services">
                                Servicios
                            </a>

                            <ul class="dropdown-menu border-0 shadow-sm rounded-3" aria-labelledby="servicesDropdown">
                                <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="creacion-cuentas-iban" data-es="Creación de cuentas IBAN" data-en="IBAN Account Creation">Creación de cuentas IBAN</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="pago-inmediato-pin" data-es="Pago Inmediato (PIN)" data-en="Immediate Payment (PIN)">Pago Inmediato (PIN)</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="debito-tiempo-real-dtr" data-es="Débito en Tiempo Real (DTR)" data-en="Real-Time Debit (RTD)">Débito en Tiempo Real (DTR)</a></li>
