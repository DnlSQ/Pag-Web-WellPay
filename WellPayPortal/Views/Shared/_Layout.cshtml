<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Well-Pay</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Bootstrap y estilos del sitio -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WellPayPortal.styles.css" asp-append-version="true" />
</head>

<body>

    <header class="sticky-top bg-white border-bottom border-light shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-light py-3">
            <div class="container">

                <!-- Logo Well-Pay -->
                <a class="navbar-brand d-flex align-items-center gap-2 fw-extrabold fs-4 text-dark"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="badge bg-wellpay text-white p-2 rounded-3 me-1">
                        <i class="bi bi-credit-card-2-front-fill fs-5"></i>
                    </span>

                    WELL-PAY
                </a>

                <!-- Botón hamburguesa para móviles -->
                <button class="navbar-toggler border-0"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMain"
                        aria-controls="navbarMain"
                        aria-expanded="false"
                        aria-label="Abrir menú">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menú -->
                <div class="collapse navbar-collapse" id="navbarMain">

                    <!-- Navegación principal -->
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 fw-semibold">

                        <!-- Servicios -->
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle px-3"
                               href="#"
                               id="servicesDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Servicios
                            </a>

                            <ul class="dropdown-menu border-0 shadow-sm rounded-3" aria-labelledby="servicesDropdown">
                                <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="creacion-cuentas-iban">Creación de cuentas IBAN</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="pago-inmediato-pin">Pago Inmediato (PIN)</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="debito-tiempo-real-dtr">Débito en Tiempo Real (DTR)</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="sinpe-movil">SINPE Móvil</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="verificador-sinpe">Verificador SINPE</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="pagos-masivos">Pagos Masivos</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="cobros-masivos">Cobros Masivos</a></li>

                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle py-2" href="#">Pagos con tarjeta</a>
                                    <ul class="dropdown-menu border-0 shadow-sm rounded-3">
                                        <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="checkout">Checkout</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="link-de-pagos">Link de pagos</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="cargos-recurrentes">Cargos recurrentes</a></li>
                                    </ul>
                                </li>

                                <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="datafonos-fisicos">Datáfonos físicos</a></li>
                            </ul>
                        </li>

                        <!-- Soluciones -->
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle px-3"
                               href="#"
                               id="solutionsDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Soluciones
                            </a>

                            <ul class="dropdown-menu border-0 shadow-sm rounded-3" aria-labelledby="solutionsDropdown">
                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle py-2" href="#">Soluciones para negocios</a>
                                    <ul class="dropdown-menu border-0 shadow-sm rounded-3">
                                        <li><a class="dropdown-item py-2" asp-controller="Soluciones" asp-action="Index" asp-fragment="medicos">Médicos</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Soluciones" asp-action="Index" asp-fragment="dentistas">Dentistas</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Soluciones" asp-action="Index" asp-fragment="comercios">Comercios</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Soluciones" asp-action="Index" asp-fragment="restaurantes">Restaurantes</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Soluciones" asp-action="Index" asp-fragment="profesionales-independientes">Profesionales independientes</a></li>
                                    </ul>
                                </li>

                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle py-2" href="#">Inteligencia Artificial</a>
                                    <ul class="dropdown-menu border-0 shadow-sm rounded-3">
                                        <li><a class="dropdown-item py-2" asp-controller="Soluciones" asp-action="Index" asp-fragment="reportes-financieros">Reportes financieros</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Soluciones" asp-action="Index" asp-fragment="score-de-riesgo">Score de riesgo</a></li>
                                    </ul>
                                </li>
                            </ul>
                        </li>

                        <!-- Desarrolladores -->
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle px-3"
                               href="#"
                               id="developersDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Desarrolladores
                            </a>

                            <ul class="dropdown-menu border-0 shadow-sm rounded-3" aria-labelledby="developersDropdown">
                                <li><a class="dropdown-item py-2" asp-controller="Desarrolladores" asp-action="Index" asp-fragment="documentacion">Documentación</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Desarrolladores" asp-action="Index" asp-fragment="integracion-servicios">Integración de servicios</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Desarrolladores" asp-action="Index" asp-fragment="api">API</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Desarrolladores" asp-action="Index" asp-fragment="sandbox">Sandbox / Ambiente de pruebas</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Desarrolladores" asp-action="Index" asp-fragment="guias-integracion">Guías de integración</a></li>
                            </ul>
                        </li>

                        <!-- Seguridad -->
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle px-3"
                               href="#"
                               id="securityDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Seguridad
                            </a>

                            <ul class="dropdown-menu border-0 shadow-sm rounded-3" aria-labelledby="securityDropdown">
                                <li><a class="dropdown-item py-2" asp-controller="Seguridad" asp-action="Index" asp-fragment="seguridad-wellpay">Seguridad en Well-Pay</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Seguridad" asp-action="Index" asp-fragment="pci-dss">PCI DSS</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Seguridad" asp-action="Index" asp-fragment="3d-secure">3-D Secure (3DS)</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Seguridad" asp-action="Index" asp-fragment="sugef">SUGEF</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Seguridad" asp-action="Index" asp-fragment="proteccion-datos">Protección de datos</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Seguridad" asp-action="Index" asp-fragment="seguridad-transacciones">Seguridad de las transacciones</a></li>
                            </ul>
                        </li>

                        <!-- Nosotros -->
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle px-3"
                               href="#"
                               id="aboutDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Nosotros
                            </a>

                            <ul class="dropdown-menu border-0 shadow-sm rounded-3" aria-labelledby="aboutDropdown">
                                <li><a class="dropdown-item py-2" asp-controller="Nosotros" asp-action="Index" asp-fragment="quienes-somos">Quiénes somos</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Nosotros" asp-action="Index" asp-fragment="mision">Misión</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Nosotros" asp-action="Index" asp-fragment="vision">Visión</a></li>

                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle py-2" href="#">Trabaja con nosotros</a>
                                    <ul class="dropdown-menu border-0 shadow-sm rounded-3">
                                        <li><a class="dropdown-item py-2" asp-controller="Nosotros" asp-action="Index" asp-fragment="postulacion">Postulación</a></li>
                                    </ul>
                                </li>

                                <li><a class="dropdown-item py-2" asp-controller="Nosotros" asp-action="Index" asp-fragment="contacto">Contacto</a></li>
                            </ul>
                        </li>

                    </ul>

                    <!-- Acciones -->
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 mt-3 mt-lg-0">

                        <!-- Iniciar sesión -->
                        <a href="https://qa.paymentpower.net/wellpay/portal/login"
                           class="btn-login-wellpay">
                            Iniciar sesión
                            <i class="bi bi-arrow-right ms-1"></i>
                        </a>

                        <!-- Solicitar afiliación -->
                        <button type="button"
                                class="btn btn-wellpay fw-bold px-4 py-2 rounded-pill shadow-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#afiliacionModal">

                            Solicitar afiliación
                        </button>

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- Contenido de cada página -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-navy text-white pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row g-4">

                <div class="col-lg-3 col-md-6">
                    <a class="navbar-brand d-flex align-items-center gap-2 fw-extrabold fs-4 text-white mb-3" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="badge bg-wellpay text-white p-2 rounded-3 me-1">
                            <i class="bi bi-credit-card-2-front-fill fs-5"></i>
                        </span>
                        WELL-PAY
                    </a>
                    <p class="text-secondary fs-7 mb-0">
                        Soluciones financieras para conectar a tu empresa con el sistema de pagos de Costa Rica.
                    </p>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="fw-bold text-white mb-3 text-center">Enlaces</h6>
                    <div class="d-flex justify-content-center gap-5">
                        <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                            <li><a class="footer-link" asp-controller="Servicios" asp-action="Index">Servicios</a></li>
                            <li><a class="footer-link" asp-controller="Soluciones" asp-action="Index">Soluciones</a></li>
                            <li><a class="footer-link" asp-controller="Desarrolladores" asp-action="Index">Desarrolladores</a></li>
                        </ul>
                        <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                            <li><a class="footer-link" asp-controller="Seguridad" asp-action="Index">Seguridad</a></li>
                            <li><a class="footer-link" asp-controller="Nosotros" asp-action="Index">Nosotros</a></li>
                            <li><a class="footer-link" asp-controller="Home" asp-action="Privacy">Privacidad</a></li>
                        </ul>
                    </div>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-white mb-3">Contacto</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        <!-- TODO: reemplazar por los datos reales -->
                        <li><a class="footer-link" href="mailto:contacto@well-pay.com"><i class="bi bi-envelope-fill me-2"></i>contacto@well-pay.com</a></li>
                        <li><a class="footer-link" href="tel:+50600000000"><i class="bi bi-telephone-fill me-2"></i>+506 0000-0000</a></li>
                        <li class="text-secondary"><i class="bi bi-geo-alt-fill me-2"></i>San José, Costa Rica</li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold text-white mb-3">Acceso</h6>
                    <a href="https://qa.paymentpower.net/wellpay/portal/login" class="btn btn-outline-light btn-sm rounded-pill px-3">
                        Iniciar sesión
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>

            </div>

            <hr class="border-secondary my-4" />

            <div class="text-center text-secondary fs-8">
                &copy; @DateTime.Now.Year Well-Pay. Todos los derechos reservados.
            </div>
        </div>
    </footer>
    <!-- MODAL FLOTANTE ESTILO STRIPE - SOLICITAR AFILIACIÓN (compartido en todas las páginas) -->
<div class="modal fade modal-stripe" id="afiliacionModal" tabindex="-1" aria-labelledby="afiliacionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden position-relative p-2 p-md-4">

            <!-- Encabezado con Logo y Botón de Cerrar -->
            <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 fw-extrabold text-dark fs-5">
                    <span class="badge bg-wellpay text-white p-2 rounded-3">
                        <i class="bi bi-credit-card-2-front-fill fs-6"></i>
                    </span>
                    <span>WELL-PAY</span>
                </div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Cuerpo del Formulario -->
            <div class="modal-body pt-3">
                <div class="mb-4">
                    <h3 class="fw-extrabold text-dark m-0 fs-4">Solicitá tu afiliación</h3>
                    <p class="text-muted fs-7 mb-0">Completá los datos para iniciar el proceso de integración con tu empresa.</p>
                </div>

                <form id="formAfiliacion">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <!-- Nombre -->
                        <div class="col-md-6">
                            <label for="nombre" class="form-label-custom">Nombre</label>
                            <input type="text" name="Nombre" class="form-control form-control-stripe" id="nombre" required />
                        </div>

                        <!-- Apellidos -->
                        <div class="col-md-6">
                            <label for="apellidos" class="form-label-custom">Apellidos</label>
                            <input type="text" name="Apellidos" class="form-control form-control-stripe" id="apellidos" required />
                        </div>

                        <!-- Cédula -->
                        <div class="col-md-6">
                            <label for="cedula" class="form-label-custom">Cédula / Identificación</label>
                            <input type="text" name="Cedula" class="form-control form-control-stripe" id="cedula"  required />
                        </div>

                        <!-- Teléfono -->
                        <div class="col-md-6">
                            <label for="telefono" class="form-label-custom">Teléfono</label>
                            <input type="tel" name="Telefono" class="form-control form-control-stripe" id="telefono" required />
                        </div>

                        <!-- Correo Electrónico -->
                        <div class="col-12">
                            <label for="correo" class="form-label-custom">Correo electrónico</label>
                            <input type="email" name="Correo" class="form-control form-control-stripe" id="correo" required />
                        </div>

                        <!-- Dirección -->
                        <div class="col-12">
                            <label for="direccion" class="form-label-custom">Dirección física</label>
                            <textarea name="Direccion" class="form-control form-control-stripe" id="direccion" rows="2" placeholder="Provincia, Cantón, Distrito y señas exactas..." required></textarea>
                        </div>
                    </div>

                    <!-- Botón Enviar -->
                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-wellpay btn-lg fs-6 fw-bold py-3 rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <span>Enviar solicitud</span>
                            <i class="bi bi-arrow-right fs-5"></i>
                        </button>
                    </div>
                </form>
            </div>

            <!-- Footer con Leyenda -->
            <div class="modal-footer border-0 pt-0 text-center justify-content-center">
                <small class="text-muted fs-8">
                    <i class="bi bi-shield-lock text-wellpay me-1"></i> Tus datos están protegidos con encriptación de grado bancario.
                </small>
            </div>

        </div>
    </div>
</div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SweetAlert -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Cierra el menú móvil automáticamente al tocar un enlace de navegación -->
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var navbarCollapse = document.getElementById('navbarMain');
            if (!navbarCollapse) return;

            var navLinks = navbarCollapse.querySelectorAll('a.nav-link:not(.dropdown-toggle), .dropdown-item');
            navLinks.forEach(function (link) {
                link.addEventListener('click', function () {
                    if (navbarCollapse.classList.contains('show')) {
                        var bsCollapse = bootstrap.Collapse.getInstance(navbarCollapse) || new bootstrap.Collapse(navbarCollapse);
                        bsCollapse.hide();
                    }
                });
            });
        });
    </script>

</body>
</html>