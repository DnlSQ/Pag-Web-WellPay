<!-- ============================================================
     HERO SOLUCIONES
     ============================================================ -->
<section id="soluciones" class="py-5 bg-white position-relative overflow-hidden hero-fade-bottom">
    <div class="container pt-3 pb-3 position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <div class="col-lg-6 ps-lg-5">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <i class="bi bi-lightbulb-fill"></i>
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;" data-es="Soluciones" data-en="Solutions">Soluciones</small>
                </div>

                <h1 class="display-5 fw-extrabold text-dark mb-3 lh-sm">
                    <span data-es="Well-Pay para " data-en="Well-Pay for ">Well-Pay para </span><span class="text-primary-custom" data-es="tu tipo de negocio" data-en="your type of business">tu tipo de negocio</span>
                </h1>

                <p class="lead text-secondary fs-6 fw-normal mb-4" data-es="Cada negocio cobra distinto. Elegí tu rubro para ver cómo Well-Pay se adapta a tu operación." data-en="Each business charges differently. Choose your industry to see how Well-Pay adapts to your operation.">
                    Cada negocio cobra distinto. Elegí tu rubro para ver cómo Well-Pay se adapta a tu operación.
                </p>

                <div class="d-flex flex-wrap align-items-center gap-3">
                    <button type="button" class="btn btn-wellpay btn-lg px-4 py-2 fs-6 fw-bold rounded-3 shadow-sm btn-full-mobile" data-bs-toggle="modal" data-bs-target="#afiliacionModal">
                        <span data-es="Solicitar afiliación" data-en="Request affiliation">Solicitar afiliación</span>
                    </button>
                    <a href="#soluciones-para-negocios" class="fw-bold pci-link-arrow d-inline-flex align-items-center gap-1">
                        <span data-es="Elegí tu rubro" data-en="Choose your industry">Elegí tu rubro</span> <i class="bi bi-arrow-down"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-6 d-none d-lg-block position-relative">
                <div class="glow-shape glow-top-right glow-half"></div>
                <div class="glow-shape glow-bottom-right glow-half"></div>

                <div class="hero-mockup-solo mx-auto">
                    <div class="dashboard-chip dashboard-chip-top d-flex">
                        <i class="bi bi-check-circle-fill text-wellpay"></i>
                        <span data-es="Pago recibido" data-en="Payment received">Pago recibido</span>
                    </div>
                    <div class="dashboard-card-mockup shadow-lg rounded-4 overflow-hidden border border-light p-4 bg-white">
                        <small class="text-muted d-block mb-1" data-es="Link de pago" data-en="Payment link">Link de pago</small>
                        <h5 class="fw-bold text-dark mb-3" data-es="Consulta general" data-en="General consultation">Consulta general</h5>
                        <div class="d-flex justify-content-between align-items-center p-3 rounded-3 bg-light mb-3">
                            <span class="fw-bold text-dark" data-es="Monto" data-en="Amount">Monto</span>
                            <span class="fw-extrabold fs-5 text-dark">₡25.000</span>
                        </div>
                        <button type="button" class="btn btn-wellpay w-100 fw-bold rounded-3" tabindex="-1">
                            <span data-es="Pagar" data-en="Pay">Pagar</span>
                        </button>
                    </div>
                    <small class="datos-ejemplo-label d-block text-center mt-2" data-es="Datos de ejemplo" data-en="Sample data">Datos de ejemplo</small>
                </div>
