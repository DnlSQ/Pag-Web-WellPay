<!-- ============================================================
     SEGURIDAD Y NOSOTROS (combinado en una sola sección)
     ============================================================ -->
<section id="seguridad" class="py-5 bg-white position-relative overflow-hidden">
    <div class="container pt-3 pb-5 position-relative" style="z-index: 2;">

        <!-- PARTE 1: SEGURIDAD -->
