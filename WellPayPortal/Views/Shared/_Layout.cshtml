                                        <li><a class="dropdown-item py-2" asp-controller="Soluciones" asp-action="Index" asp-fragment="medicos" data-es="Médicos" data-en="Doctors">Médicos</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Soluciones" asp-action="Index" asp-fragment="dentistas" data-es="Dentistas" data-en="Dentists">Dentistas</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Soluciones" asp-action="Index" asp-fragment="comercios" data-es="Comercios" data-en="Retail">Comercios</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Soluciones" asp-action="Index" asp-fragment="restaurantes" data-es="Restaurantes" data-en="Restaurants">Restaurantes</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Soluciones" asp-action="Index" asp-fragment="profesionales-independientes" data-es="Profesionales independientes" data-en="Freelancers">Profesionales independientes</a></li>
                                    </ul>
                                </li>

                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle py-2" href="#" data-es="Inteligencia Artificial" data-en="Artificial Intelligence">Inteligencia Artificial</a>
