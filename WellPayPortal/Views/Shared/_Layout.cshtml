                                <li><a class="dropdown-item py-2" asp-controller="Seguridad" asp-action="Index" asp-fragment="proteccion-datos" data-es="Protección de datos" data-en="Data Protection">Protección de datos</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Seguridad" asp-action="Index" asp-fragment="seguridad-transacciones" data-es="Seguridad de las transacciones" data-en="Transaction Security">Seguridad de las transacciones</a></li>
                            </ul>
                        </li>

                        <!-- Nosotros -->
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle px-3"
                               href="#"
                               id="aboutDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false"
                               data-es="Nosotros"
                               data-en="About">
                                Nosotros
                            </a>

                            <ul class="dropdown-menu border-0 shadow-sm rounded-3" aria-labelledby="aboutDropdown">
                                <li><a class="dropdown-item py-2" asp-controller="Nosotros" asp-action="Index" asp-fragment="quienes-somos" data-es="Quiénes somos" data-en="Who We Are">Quiénes somos</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Nosotros" asp-action="Index" asp-fragment="mision" data-es="Misión" data-en="Mission">Misión</a></li>
                                <li><a class="dropdown-item py-2" asp-controller="Nosotros" asp-action="Index" asp-fragment="vision" data-es="Visión" data-en="Vision">Visión</a></li>

                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle py-2" href="#" data-es="Trabaja con nosotros" data-en="Work With Us">Trabaja con nosotros</a>
                                    <ul class="dropdown-menu border-0 shadow-sm rounded-3">
                                        <li><a class="dropdown-item py-2" asp-controller="Nosotros" asp-action="Index" asp-fragment="postulacion" data-es="Postulación" data-en="Apply">Postulación</a></li>
                                    </ul>
                                </li>

                                <li><a class="dropdown-item py-2" asp-controller="Nosotros" asp-action="Index" asp-fragment="contacto" data-es="Contacto" data-en="Contact">Contacto</a></li>
                            </ul>
                        </li>

                    </ul>

                    <!-- Acciones -->
                    <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 mt-3 mt-lg-0">

                        <!-- Cambiar idioma -->
                        <button id="langToggle" 
                                class="btn btn-sm btn-outline-dark rounded-pill px-3" 
                                title="Toggle language">
                            English
                        </button>

                        <!-- Iniciar sesión -->
                        <a href="https://qa.paymentpower.net/wellpay/portal/login"
                           class="btn-login-wellpay"
                           data-es="Iniciar sesión"
                           data-en="Sign In">
                            Iniciar sesión
                            <i class="bi bi-arrow-right ms-1"></i>
                        </a>

                        <!-- Solicitar afiliación -->
                        <button type="button"
                                class="btn btn-wellpay fw-bold px-4 py-2 rounded-pill shadow-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#afiliacionModal"
                                data-es="Solicitar afiliación"
                                data-en="Request Affiliation">

                            Solicitar afiliación
                        </button>

                    </div>

                </div>
            </div>
        </nav>
    </header>

