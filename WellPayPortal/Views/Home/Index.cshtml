                                        <div>
                                            <div class="fw-bold text-dark" data-es="Pago recibido - Cliente A" data-en="Payment Received - Client A">Pago recibido - Cliente A</div>
                                            <small class="text-muted" style="font-size: 0.6rem;" data-es="Hoy, 10:45 a. m." data-en="Today, 10:45 a.m.">Hoy, 10:45 a. m.</small>
                                        </div>
                                    </div>
                                    <span class="fw-bold text-success">+ ₡125.000,00</span>
                                </div>

                                <div class="d-flex align-items-center justify-content-between p-1 border-bottom">
