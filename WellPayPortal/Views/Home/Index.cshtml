                    <span class="dot-indicator"></span>
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px;" data-es="SOLUCIONES FINANCIERAS PARA EMPRESAS" data-en="FINANCIAL SOLUTIONS FOR BUSINESSES">SOLUCIONES FINANCIERAS PARA EMPRESAS</small>
                </div>

                <!-- Título Principal -->
                <h1 class="display-5 fw-extrabold text-dark mb-3 lh-sm">
                    <span data-es="Conectá tu empresa con el sistema financiero" data-en="Connect your business with the financial system">Conectá tu empresa con el sistema financiero</span> <br class="d-none d-md-inline" />
                    <span class="text-primary-custom" data-es="de Costa Rica." data-en="in Costa Rica.">de Costa Rica.</span>
