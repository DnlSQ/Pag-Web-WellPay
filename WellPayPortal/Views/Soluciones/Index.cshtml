@{
    ViewData["Title"] = "Soluciones";
}

<!-- MINI HERO SOLUCIONES -->
<section id="soluciones" class="py-5 bg-white position-relative overflow-hidden">
    <div class="glow-shape glow-top-right"></div>
    <div class="glow-shape glow-bottom-right"></div>

    <div class="container py-4 position-relative text-center" style="z-index: 2;">
        <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
            <i class="bi bi-lightbulb-fill"></i>
            <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;">Soluciones</small>
        </div>

        <h1 class="display-5 fw-extrabold text-dark mb-3 lh-sm">
            Well-Pay para <span class="text-primary-custom">tu tipo de negocio</span>
        </h1>

        <p class="lead text-secondary fs-6 fw-normal mx-auto" style="max-width: 700px;">
            Cada negocio cobra distinto. Elegí tu rubro para ver cómo Well-Pay se adapta a tu operación.
        </p>
    </div>
</section>

<!-- ============================================================
     SOLUCIONES PARA NEGOCIOS
     ============================================================ -->
<section id="soluciones-para-negocios" class="py-5 position-relative overflow-hidden bg-light-subtle">
    <div class="glow-shape glow-services-top-left"></div>
    <div class="glow-shape glow-services-bottom-right"></div>

    <div class="container py-5 position-relative" style="z-index: 2;">
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;">Soluciones para negocios</small>
                </div>

                <h2 class="display-6 fw-extrabold text-dark mb-4 lh-sm">
                    Una solución <span class="text-primary-custom">para cada rubro</span>
                </h2>

                <!-- TODO: confirmar/ajustar el mensaje específico de cada rubro con el equipo comercial -->
                <p class="lead text-secondary fs-6 fw-normal">
                    No vendemos lo mismo a todos. Así acompañamos a cada tipo de negocio.
                </p>
            </div>
        </div>

        <div class="row g-4 row-cols-1 row-cols-sm-2 row-cols-lg-3">
            <div id="medicos" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 28px;">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                        <i class="bi bi-heart-fill fs-4"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Médicos</h6>
                    <p class="text-muted mb-0 small">
                        Cobrá consultas y tratamientos con links de pago y facturación electrónica lista
                        para enviar a tus pacientes.
                    </p>
                </div>
            </div>

            <div id="dentistas" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 28px;">
                    <div class="service-icon-shape bg-light-blue text-primary-custom rounded-circle mb-3">
                        <i class="bi bi-emoji-smile-fill fs-4"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Dentistas</h6>
                    <p class="text-muted mb-0 small">
                        Manejá tratamientos de varias sesiones con cobros recurrentes y recordatorios
                        de pago automáticos.
                    </p>
                </div>
            </div>

            <div id="comercios" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 28px;">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                        <i class="bi bi-shop fs-4"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Comercios</h6>
                    <p class="text-muted mb-0 small">
                        Aceptá pagos en tu tienda física con datáfono y en línea con checkout, desde
                        una sola cuenta.
                    </p>
                </div>
            </div>

            <div id="restaurantes" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 28px;">
                    <div class="service-icon-shape bg-light-blue text-primary-custom rounded-circle mb-3">
                        <i class="bi bi-cup-hot-fill fs-4"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Restaurantes</h6>
                    <p class="text-muted mb-0 small">
                        Cobrá rápido en mesa con SINPE Móvil o tarjeta, y llevá el control de tus
                        transacciones del día.
                    </p>
                </div>
            </div>

            <div id="profesionales-independientes" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 28px;">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                        <i class="bi bi-briefcase-fill fs-4"></i>
                    </div>
                    <h6 class="fw-bold text-dark mb-2">Profesionales independientes</h6>
                    <p class="text-muted mb-0 small">
                        Compartí un link de pago con tu cliente y cobrá sin necesidad de tener
                        una tienda en línea propia.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     INTELIGENCIA ARTIFICIAL
     ============================================================ -->
<section id="inteligencia-artificial" class="py-5 bg-white position-relative overflow-hidden">
    <div class="container py-3 position-relative" style="z-index: 2;">
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;">Inteligencia Artificial</small>
                </div>

                <h2 class="display-6 fw-extrabold text-dark mb-4 lh-sm">
                    Tus datos, <span class="text-primary-custom">convertidos en decisiones</span>
                </h2>

                <!-- TODO: confirmar alcance real de esta funcionalidad con el equipo -->
                <p class="lead text-secondary fs-6 fw-normal">
                    Más allá de procesar tus cobros, Well-Pay te ayuda a entender tu propio negocio:
                    un panel con inteligencia artificial que analiza tus ventas y te da información
                    clara para tomar mejores decisiones.
                </p>

                <p class="text-muted small fst-italic">
                    Esto es distinto a la seguridad de las transacciones (que protege cada pago
                    por dentro): acá hablamos de lo que vos, como negocio, ves y usás en tu día a día.
                </p>
            </div>
        </div>

        <div class="row g-4 row-cols-1 row-cols-md-2 justify-content-center">
            <div id="reportes-financieros" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 32px;">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                        <i class="bi bi-bar-chart-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Reportes financieros</h5>
                    <p class="text-muted mb-0">
                        Visualizá el volumen procesado, tus transacciones y tendencias de venta en
                        un panel claro, con insights generados automáticamente sobre el
                        comportamiento de tu negocio.
                    </p>
                </div>
            </div>

            <div id="score-de-riesgo" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 32px;">
                    <div class="service-icon-shape bg-light-blue text-primary-custom rounded-circle mb-3">
                        <i class="bi bi-speedometer2 fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Score de riesgo</h5>
                    <p class="text-muted mb-0">
                        Un indicador que resume la salud de tu operación (disputas, rechazos,
                        patrones inusuales), para que identifiques a tiempo algo que merezca
                        tu atención.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
