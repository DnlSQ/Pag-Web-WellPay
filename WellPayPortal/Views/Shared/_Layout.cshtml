                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle py-2" href="#" data-es="Pagos con tarjeta" data-en="Card Payments">Pagos con tarjeta</a>
                                    <ul class="dropdown-menu border-0 shadow-sm rounded-3">
                                        <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="checkout" data-es="Checkout" data-en="Checkout">Checkout</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="link-de-pagos" data-es="Link de pagos" data-en="Payment Link">Link de pagos</a></li>
                                    </ul>
                                </li>

                                <li class="dropdown-submenu">
                                    <a class="dropdown-item dropdown-toggle py-2" href="#" data-es="Cargos recurrentes" data-en="Recurring Charges">Cargos recurrentes</a>
                                    <ul class="dropdown-menu border-0 shadow-sm rounded-3">
                                        <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="cargos-recurrentes" data-es="Cargos recurrentes" data-en="Recurring Charges">Cargos recurrentes</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="cargos-recurrentes-sinpe" data-es="Cuenta SINPE" data-en="SINPE Account">Cuenta SINPE</a></li>
                                        <li><a class="dropdown-item py-2" asp-controller="Servicios" asp-action="Index" asp-fragment="cargos-recurrentes-tarjeta" data-es="Tarjeta crédito / débito" data-en="Credit / Debit Card">Tarjeta crédito / débito</a></li>
