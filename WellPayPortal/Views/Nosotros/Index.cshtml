@{
    ViewData["Title"] = "Nosotros";
}

<!-- MINI HERO NOSOTROS -->
<section class="py-5 bg-white position-relative overflow-hidden hero-fade-bottom">
    <div class="container py-3 position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;">Nosotros</small>
                </div>

                <h1 class="display-5 fw-extrabold text-dark mb-3 lh-sm">
                    Conocé a <span class="text-primary-custom">Well-Pay</span>
                </h1>

                <p class="lead text-secondary fs-6 fw-normal">
                    Quiénes somos, hacia dónde vamos y cómo trabajamos para impulsar el sistema financiero de Costa Rica.
                </p>
            </div>

            <div class="col-lg-6 d-none d-lg-block position-relative">
                <div class="glow-shape glow-top-right glow-half"></div>
                <div class="glow-shape glow-bottom-right glow-half"></div>

                <div class="dashboard-card-mockup shadow-lg rounded-4 overflow-hidden border border-light p-4 bg-white mx-auto position-relative" style="max-width: 340px; z-index: 2;">
                    <small class="text-muted d-block mb-3">Lo que nos define</small>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="pillar-icon-sm bg-light-green text-wellpay flex-shrink-0"><i class="bi bi-lightning-charge-fill"></i></span>
                        <div>
                            <span class="fw-bold text-dark d-block">Agilidad</span>
                            <span class="text-muted small">Resolvemos rápido, sin trámites innecesarios.</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="pillar-icon-sm bg-light-blue text-primary-custom flex-shrink-0"><i class="bi bi-people-fill"></i></span>
                        <div>
                            <span class="fw-bold text-dark d-block">Cercanía</span>
                            <span class="text-muted small">Acompañamos a cada negocio como si fuera propio.</span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="pillar-icon-sm bg-light-green text-wellpay flex-shrink-0"><i class="bi bi-graph-up-arrow"></i></span>
                        <div>
                            <span class="fw-bold text-dark d-block">Innovación</span>
                            <span class="text-muted small">Mejoramos constantemente nuestra plataforma.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     QUIÉNES SOMOS (incluye historia, misión, visión y valores)
     ============================================================ -->
<section id="quienes-somos" class="py-5 bg-white position-relative overflow-hidden">
    <div class="container pt-3 pb-5 position-relative" style="z-index: 2;">

        <div class="row align-items-center g-5 mb-5">
            <div class="col-lg-6">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;">Quiénes somos</small>
                </div>

                <h2 class="display-5 fw-extrabold text-dark mb-4 lh-sm">
                    Nuestra <span class="text-primary-custom">historia y trayectoria</span>
                </h2>

                <!-- TODO: reemplazar por la historia real de la empresa (año de fundación, hitos, fundadores, etc.) -->
                <p class="text-secondary fs-6 fw-normal mb-3">
                    Well-Pay nace con el objetivo de simplificar la forma en que las empresas costarricenses
                    reciben y gestionan sus pagos. Desde nuestros inicios, trabajamos de la mano de comercios,
                    profesionales independientes y desarrolladores para construir una infraestructura de pagos
                    moderna, segura y adaptada a la realidad del mercado local.
                </p>

                <p class="text-secondary fs-6 fw-normal mb-0">
                    Hoy seguimos creciendo junto a nuestros clientes, incorporando nuevas soluciones financieras
                    y tecnológicas que acompañan a cada negocio en su día a día.
                </p>
            </div>

            <div class="col-lg-6">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 32px; cursor: pointer;"
                     data-bs-toggle="modal" data-bs-target="#valoresModal">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                        <i class="bi bi-heart-fill fs-4"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-3">Valores</h4>
                    <p class="text-muted mb-0">Seguridad, agilidad, cercanía e innovación guían todo lo que hacemos.</p>
                </div>
            </div>
        </div>

        <!-- MISIÓN Y VISIÓN -->
        <div id="mision" class="row g-4 row-cols-1 row-cols-md-2">
            <div class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 32px; cursor: pointer;"
                     data-bs-toggle="modal" data-bs-target="#misionModal">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                        <i class="bi bi-bullseye fs-4"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-3">Misión</h4>
                    <!-- TODO: confirmar redacción oficial de la misión -->
                    <p class="text-muted mb-0">
                        Facilitar el acceso de las empresas costarricenses a herramientas de pago seguras,
                        ágiles y en tiempo real, impulsando su crecimiento y competitividad.
                    </p>
                </div>
            </div>

            <div id="vision" class="col">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle" style="border-radius: 32px; cursor: pointer;"
                     data-bs-toggle="modal" data-bs-target="#visionModal">
                    <div class="service-icon-shape bg-light-blue text-primary-custom rounded-circle mb-3">
                        <i class="bi bi-eye-fill fs-4"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-3">Visión</h4>
                    <!-- TODO: confirmar redacción oficial de la visión -->
                    <p class="text-muted mb-0">
                        Ser la plataforma de pagos de referencia en Costa Rica, reconocida por su seguridad,
                        innovación y cercanía con cada cliente.
                    </p>
                </div>
            </div>
        </div>


    </div>
</section>

        <!-- MODAL - MISIÓN -->
        <div class="modal fade modal-stripe" id="misionModal" tabindex="-1" aria-labelledby="misionModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden position-relative p-2 p-md-4">
                    <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center">
                        <h4 class="modal-title fw-bold text-dark" id="misionModalLabel">Nuestra Misión</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-2">
                        <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3">
                            <i class="bi bi-bullseye fs-4"></i>
                        </div>
                        <!-- TODO: confirmar redacción oficial y ampliada de la misión -->
                        <p class="text-secondary mb-0">
                            Facilitar el acceso de las empresas costarricenses a herramientas de pago seguras,
                            ágiles y en tiempo real, impulsando su crecimiento y competitividad. Trabajamos
                            cada día para que cualquier negocio, sin importar su tamaño, pueda cobrar y pagar
                            de forma simple, moderna y confiable.
                        </p>
                    </div>
                    <div class="modal-footer border-0 pt-0 text-center justify-content-center">
                        <button type="button" class="btn btn-wellpay fw-bold px-4 py-2 rounded-pill" data-bs-dismiss="modal">Entendido</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL - VISIÓN -->
        <div class="modal fade modal-stripe" id="visionModal" tabindex="-1" aria-labelledby="visionModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden position-relative p-2 p-md-4">
                    <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center">
                        <h4 class="modal-title fw-bold text-dark" id="visionModalLabel">Nuestra Visión</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-2">
                        <div class="service-icon-shape bg-light-blue text-primary-custom rounded-circle mb-3">
                            <i class="bi bi-eye-fill fs-4"></i>
                        </div>
                        <!-- TODO: confirmar redacción oficial y ampliada de la visión -->
                        <p class="text-secondary mb-0">
                            Ser la plataforma de pagos de referencia en Costa Rica, reconocida por su seguridad,
                            innovación y cercanía con cada cliente. Aspiramos a que cada vez más negocios del
                            país elijan a Well-Pay como su aliado de confianza para gestionar sus pagos.
                        </p>
                    </div>
                    <div class="modal-footer border-0 pt-0 text-center justify-content-center">
                        <button type="button" class="btn btn-wellpay fw-bold px-4 py-2 rounded-pill" data-bs-dismiss="modal">Entendido</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODAL - VALORES -->
        <div class="modal fade modal-stripe" id="valoresModal" tabindex="-1" aria-labelledby="valoresModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden position-relative p-2 p-md-4">
                    <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center">
                        <h4 class="modal-title fw-bold text-dark" id="valoresModalLabel">Nuestros Valores</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body pt-2">
                        <!-- TODO: confirmar redacción oficial de cada valor -->
                        <div class="row g-3">
                            <div class="col-md-6 d-flex gap-2">
                                <i class="bi bi-shield-check text-wellpay fs-5 mt-1"></i>
                                <div>
                                    <strong class="d-block text-dark">Seguridad</strong>
                                    <span class="text-muted small">Protegemos cada operación y cada dato de nuestros clientes.</span>
                                </div>
                            </div>
                            <div class="col-md-6 d-flex gap-2">
                                <i class="bi bi-lightning-charge-fill text-wellpay fs-5 mt-1"></i>
                                <div>
                                    <strong class="d-block text-dark">Agilidad</strong>
                                    <span class="text-muted small">Resolvemos rápido, sin trámites innecesarios.</span>
                                </div>
                            </div>
                            <div class="col-md-6 d-flex gap-2">
                                <i class="bi bi-people-fill text-wellpay fs-5 mt-1"></i>
                                <div>
                                    <strong class="d-block text-dark">Cercanía</strong>
                                    <span class="text-muted small">Acompañamos a cada negocio como si fuera propio.</span>
                                </div>
                            </div>
                            <div class="col-md-6 d-flex gap-2">
                                <i class="bi bi-graph-up-arrow text-wellpay fs-5 mt-1"></i>
                                <div>
                                    <strong class="d-block text-dark">Innovación</strong>
                                    <span class="text-muted small">Mejoramos constantemente nuestra plataforma y servicios.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 text-center justify-content-center">
                        <button type="button" class="btn btn-wellpay fw-bold px-4 py-2 rounded-pill" data-bs-dismiss="modal">Entendido</button>
                    </div>
                </div>
            </div>
        </div>

<!-- ============================================================
     TRABAJA CON NOSOTROS (incluye Postulación)
     ============================================================ -->
<section id="trabaja-con-nosotros" class="py-5 position-relative overflow-hidden bg-light-subtle">

    <div class="container py-3 position-relative" style="z-index: 2;">

        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 bg-success-subtle text-success fw-bold px-3 py-1 rounded-pill mb-3 style-badge">
                    <small style="font-size: 0.9rem; letter-spacing: 0.5px; text-transform: uppercase;">Trabaja con nosotros</small>
                </div>

                <h2 class="display-5 fw-extrabold text-dark mb-4 lh-sm">
                    Construí el futuro de los <span class="text-primary-custom">pagos en Costa Rica</span>
                </h2>

                <!-- TODO: confirmar mensaje oficial sobre cultura/beneficios de la empresa -->
                <p class="lead text-secondary fs-6 fw-normal">
                    En Well-Pay creemos en equipos cercanos, ágiles y comprometidos con la innovación
                    financiera. Si te apasiona la tecnología y los pagos, queremos conocerte.
                </p>
            </div>
        </div>

        <div id="postulacion" class="row justify-content-center">
            <div class="col-lg-6">
                <div class="service-card h-100 bg-white p-4 shadow-sm border border-light-subtle text-center" style="border-radius: 32px;">
                    <div class="service-icon-shape bg-light-green text-wellpay rounded-circle mb-3 mx-auto">
                        <i class="bi bi-send-fill fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Postulación</h5>
                    <!-- TODO: definir el flujo real de postulación (formulario propio, ATS externo, etc.) -->
                    <p class="text-muted mb-3">
                        Enviános tu currículum y contanos en qué área te gustaría aportar tu talento.
                    </p>
                    <button type="button"
                            class="btn btn-wellpay fw-bold px-4 py-2 rounded-pill shadow-sm"
                            data-bs-toggle="modal" data-bs-target="#postulacionModal">
                        Enviar mi CV
                        <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- MODAL - POSTULACIÓN -->
<div class="modal fade modal-stripe" id="postulacionModal" tabindex="-1" aria-labelledby="postulacionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow-lg overflow-hidden position-relative p-2 p-md-4">

            <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center">
                <h4 class="modal-title fw-bold text-dark" id="postulacionModalLabel">Postulación</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body pt-2">
                <p class="text-muted mb-4">
                    Contanos un poco sobre vos y adjuntá tu currículum en PDF.
                </p>

                <form id="formPostulacion" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="postulacionNombre" class="form-label-custom">Nombre completo</label>
                            <input type="text" name="Nombre" class="form-control form-control-stripe" id="postulacionNombre" required />
                        </div>

                        <div class="col-md-6">
                            <label for="postulacionTelefono" class="form-label-custom">Teléfono</label>
                            <input type="tel" name="Telefono" class="form-control form-control-stripe" id="postulacionTelefono" required />
                        </div>

                        <div class="col-12">
                            <label for="postulacionCorreo" class="form-label-custom">Correo electrónico</label>
                            <input type="email" name="Correo" class="form-control form-control-stripe" id="postulacionCorreo" required />
                        </div>

                        <div class="col-12">
                            <label for="postulacionArea" class="form-label-custom">Área de interés</label>
                            <select name="AreaInteres" class="form-control form-control-stripe" id="postulacionArea" required>
                                <option value="" selected disabled>Seleccioná un área...</option>
                                <option value="Desarrollo / Tecnología">Desarrollo / Tecnología</option>
                                <option value="Ventas / Comercial">Ventas / Comercial</option>
                                <option value="Atención al cliente">Atención al cliente</option>
                                <option value="Administración / Finanzas">Administración / Finanzas</option>
                                <option value="Otra">Otra</option>
                            </select>
                        </div>

                        <div class="col-12">
                            <label for="postulacionCv" class="form-label-custom">Currículum (PDF, máx. 5MB)</label>
                            <input type="file" name="Cv" class="form-control form-control-stripe" id="postulacionCv" accept="application/pdf" required />
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-wellpay btn-lg fs-6 fw-bold py-3 rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <span>Enviar postulación</span>
                            <i class="bi bi-arrow-right fs-5"></i>
                        </button>
                    </div>
                </form>
            </div>

            <div class="modal-footer border-0 pt-0 text-center justify-content-center">
                <small class="text-muted fs-8">
                    <i class="bi bi-shield-lock text-wellpay me-1"></i> Tu información y CV se envían de forma segura.
                </small>
            </div>

        </div>
    </div>
</div>

<!-- ============================================================
     CONTACTO
     ============================================================ -->
